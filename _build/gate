# ── ЕДИНЫЙ сборщик конфига ВЫХОДА (C2) ────────────────────────────────
# Одна точка правды на все режимы. Раньше vpn и socks писали конфиг C2 каждый своим инлайн-
# питоном и затирали друг друга — поэтому несколько выходов одновременно были невозможны.
#
# Собираем конфиг ЦЕЛИКОМ здесь, на малине (тут лежат состояние, раскладка каналов и профили
# носков), а на C2 только проверяем `xray -test` и подменяем. Базу берём у chain-render
# (inbound с reality-ключами), поверх кладём outbounds/routing.
#
# Что получается:
#   • ГЛОБАЛЬНЫЙ выход (gate global …) — для всех НЕназначенных клиентов (идентичность lane-main);
#   • КАНАЛ (lane-N) — для назначенных: свой выход у каждого канала, в т.ч. РАЗНЫЕ носки;
#   • fail-closed: выход канала недоступен → канал в blocked (не утекает мимо назначения);
#     `direct` присутствует, ТОЛЬКО если он кому-то реально нужен (глобальный c2 или канал c2) —
#     иначе реальный IP C2 нечем засветить даже при баге в правилах.
exit_apply(){
  local last tmp b64 out
  last="$(python3 -c "import json;print(len(json.load(open('$CHAIN_JSON'))['hops'])-1)" 2>/dev/null)"
  [ -n "$last" ] || { echo "  ✗ не прочитать chain.json"; return 1; }
  tmp="$(mktemp --suffix=.json)" || return 1
  python3 "$RENDER" node "$CHAIN_JSON" "$last" > "$tmp" || { rm -f "$tmp"; echo "  ✗ рендер выхода"; return 1; }
  # pushed-DNS туннеля забираем с C2 (его пишет gate-vpn при подъёме)
  local pushed=""
  [ "$(cat "$VPN_STATE" 2>/dev/null)" = on ] && \
    pushed="$(s2_exec "cat $C2_VPN_DIR/pushed-dns 2>/dev/null | tr '\n' ' '" 2>/dev/null | tr -d '\r')"
  local fb=""; [ "$(cat "$DNS_FALLBACK_STATE" 2>/dev/null)" = on ] && fb="$DNS_FALLBACK_SERVERS"
  # правим как root: профили носков и client-lanes лежат root-only
  local tmp2; tmp2="$(mktemp --suffix=.json)" || { rm -f "$tmp"; return 1; }
  # stdout (готовый конфиг) → $tmp2: файл открывает ШЕЛЛ от pi, root пишет уже в готовый fd.
  # Так обходим запрет ядра (fs.protected_regular): root НЕ может открыть на запись чужой
  # файл в sticky-каталоге /tmp. stderr (заметки) забираем в подстановку.
  out="$(sudo GATE_PUSHED_DNS="$pushed" GATE_DNS_FALLBACK="$fb" python3 - "$tmp" 2>&1 1>"$tmp2" <<'PYEOF'
import json, os, sys

cfg_path   = sys.argv[1]
GLOBAL_F   = "/etc/gate/global-exit.conf"
LANES_F    = "/etc/gate/client-lanes.conf"
PROF_SOCKS = "/etc/gate/profiles/socks"
SOCKS_CONF = "/etc/gate/socks.conf"
SOCKS_CAPS = "/etc/gate/socks.caps"
VPN_STATE  = "/etc/gate/vpn.state"

def kv(path):
    d = {}
    try:
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip()
    except OSError:
        pass
    return d

def state(path):
    try: return open(path).read().strip()
    except OSError: return ""

g       = kv(GLOBAL_F)
gexit   = g.get("GLOBAL") or "c2"
gprof   = g.get("GLOBAL_SOCKS") or ""
vpn_on  = state(VPN_STATE) == "on"

# каналы: {канал: выход}  (выход = c2 | vpn | socks:<профиль>)
chans = {}
try:
    for line in open(LANES_F):
        line = line.strip()
        if line and not line.startswith("#"):
            f = line.split()
            if len(f) >= 4:
                chans[f[2]] = f[3]
except OSError:
    pass

def socks_cfg(prof):
    """Параметры носка: именованный профиль или безымянный (gate socks set)."""
    return kv(os.path.join(PROF_SOCKS, prof + ".conf")) if prof else kv(SOCKS_CONF)

def socks_udp_ok(prof):
    """UDP разрешаем, только если проба подтвердила (иначе режем — fail-closed, как в
    глобальном режиме: без UDP ASSOCIATE трафик ушёл бы мимо носка)."""
    caps = os.path.join(PROF_SOCKS, prof + ".caps") if prof else SOCKS_CAPS
    try:
        return any(l.strip() == "UDP=ok" for l in open(caps))
    except OSError:
        return False

def mk_socks(tag, prof):
    s = socks_cfg(prof)
    if not s.get("SOCKS_IP") or not s.get("SOCKS_PORT"):
        return None
    ob = {"tag": tag, "protocol": "socks",
          "settings": {"servers": [{"address": s["SOCKS_IP"], "port": int(s["SOCKS_PORT"])}]}}
    if s.get("SOCKS_USER"):
        ob["settings"]["servers"][0]["users"] = [
            {"user": s["SOCKS_USER"], "pass": s.get("SOCKS_PASS", "")}]
    return ob

c = json.load(open(cfg_path))
old = {o.get("tag"): o for o in c.get("outbounds", [])}
# direct берём ИЗ БАЗЫ (chain-render): там может быть sendThrough, если у C2 несколько IPv4
direct = old.get("direct") or {"tag": "direct", "protocol": "freedom",
                               "settings": {"domainStrategy": "AsIs"}}
vpn_ob = {"tag": "vpn-out", "protocol": "freedom", "settings": {"domainStrategy": "AsIs"},
          "streamSettings": {"sockopt": {"mark": 2}}}

obs   = [{"tag": "blocked", "protocol": "blackhole"}]
rules = []
need_direct = False
notes = []

# ── куда ведёт конкретный выход (спека) → tag аутбаунда, добавляя его при надобности ──
socks_tags = {}   # профиль → tag (один аутбаунд на профиль, сколько бы каналов ни вело)
def resolve(spec, who):
    global need_direct
    if spec in ("c2", "", None):
        need_direct = True
        return "direct", True
    if spec == "vpn":
        if not vpn_on:
            notes.append("%s: VPN-туннель не поднят" % who)
            return "blocked", False
        if not any(o["tag"] == "vpn-out" for o in obs):
            obs.append(vpn_ob)
        return "vpn-out", True
    if spec.startswith("socks:") or spec == "socks":
        prof = spec[6:] if spec.startswith("socks:") else gprof
        key = prof or "_default"
        if key not in socks_tags:
            tag = "socks-out-" + (prof if prof else "default")
            ob = mk_socks(tag, prof)
            if ob is None:
                notes.append("%s: нет параметров носка «%s»" % (who, prof or "по умолчанию"))
                return "blocked", False
            obs.append(ob); socks_tags[key] = tag
        return socks_tags[key], socks_udp_ok(prof)
    notes.append("%s: неизвестный выход «%s»" % (who, spec))
    return "blocked", False

# ── DNS туннеля (только когда глобальный выход — VPN) ──
pushed = [x for x in os.environ.get("GATE_PUSHED_DNS", "").split() if x]
fbl    = [x for x in os.environ.get("GATE_DNS_FALLBACK", "").split() if x]
use    = (pushed if pushed else fbl) if (gexit in ("ovpn", "pptp") and vpn_on) else []
if use:
    c["dns"] = {"servers": use, "queryStrategy": "UseIPv4"}
    ds = "IpOnDemand"
else:
    c.pop("dns", None)
    ds = "AsIs"

# ── глобальный выход (для неназначенных, идентичность lane-main) ──
gspec = {"ovpn": "vpn", "pptp": "vpn", "socks": "socks", "c2": "c2"}.get(gexit, "c2")
gtag, gudp = resolve(gspec, "глобальный выход")

# DNS туннеля может быть приватным шлюзом (10.x) → правило ДО geoip:private, иначе зарежется
if use:
    rules.append({"type": "field", "ip": use, "outboundTag": "vpn-out"})
rules.append({"type": "field", "ip": ["geoip:private"], "outboundTag": "blocked"})

# ── каналы: у каждого свой выход (в т.ч. РАЗНЫЕ носки одновременно) ──
for ch in sorted(chans, key=lambda x: (0, int(x)) if x.isdigit() else (1, x)):
    tag, udp_ok = resolve(chans[ch], "канал %s" % ch)
    email = "lane-" + ch
    if not udp_ok and tag != "blocked":
        rules.append({"type": "field", "user": [email], "network": "udp", "outboundTag": "blocked"})
    rules.append({"type": "field", "user": [email], "outboundTag": tag})

# ── всё остальное → глобальный выход ──
if not gudp and gtag != "blocked":
    rules.append({"type": "field", "network": "udp", "outboundTag": "blocked"})
rules.append({"type": "field", "network": "tcp,udp", "outboundTag": gtag})

if need_direct:
    obs.append(direct)
c["outbounds"] = obs
c["routing"] = {"domainStrategy": ds, "rules": rules}
for n in notes:
    print("NOTE=" + n, file=sys.stderr)
print("OUT=" + ",".join(o["tag"] for o in obs), file=sys.stderr)
json.dump(c, sys.stdout, indent=2)
PYEOF
)" || { rm -f "$tmp" "$tmp2"; echo "  ✗ сборка конфига выхода не удалась"; return 1; }
  printf '%s\n' "$out" | sed -n 's/^NOTE=/  ⚠ /p'
  [ -s "$tmp2" ] || { rm -f "$tmp" "$tmp2"; echo "  ✗ получился пустой конфиг выхода"; return 1; }
  b64="$(base64 -w0 "$tmp2")"; rm -f "$tmp" "$tmp2"
  # На C2: проверяем и подменяем. Расширение .json обязательно — xray берёт формат из него.
  s2_exec "printf '%s' '$b64' | base64 -d > /tmp/gate-exit-new.json
xray -test -config /tmp/gate-exit-new.json >/dev/null 2>&1 || { rm -f /tmp/gate-exit-new.json; echo XBAD-CONFIG; exit 1; }
cat /tmp/gate-exit-new.json > $EXIT_XRAY_CONF; rm -f /tmp/gate-exit-new.json
systemctl restart xray && sleep 2 && systemctl is-active xray"
}

vpn_on(){  # $1 = ovpn|pptp
  local t="$1"
  echo "→ Поднимаю VPN-выход ($t) на C2 (xray→vpn-out fwmark, killswitch)…"
  ensure_vpn_script || { echo "  ✗ не удалось обновить gate-vpn на C2"; exit 1; }  # сверка sha256, перезалив лишь при отличии
  # Туннель поднимаем ПЕРВЫМ → tun0/ppp0 + pushed-DNS на C2, и только потом конфиг xray.
  # КРИТИЧНО: если туннель не встал — конфиг выхода НЕ трогаем. Иначе xray уезжает в killswitch
  # без рабочего tun0 → цепочка мертва, хотя прямой выход C2 был исправен.
  if ! s2_exec "echo $t > $C2_VPN_DIR/type
gate-vpn up"; then
    echo "  ${RED}✗ туннель ($t) не поднялся${R} — выход остаётся ${GRN}прямым (C2)${R}, цепочка цела"
    echo "     ${D}подробности: gate ovpn log   ·   проверить конфиг: gate ovpn check <файл.ovpn>${R}"
    return 1
  fi
  # Флаги ставим ДО сборки: exit_apply читает состояние из файлов.
  echo on | sudo tee "$VPN_STATE" >/dev/null
  echo "TYPE=$t" | sudo tee "$VPN_META" >/dev/null
  sudo bash -c "printf 'GLOBAL=%s\nGLOBAL_SOCKS=\n' '$t' > $GLOBAL_EXIT"
  # носок больше не глобальный выход → снимаем его флаг, иначе статус и exit_apply
  # видят два «включённых» выхода сразу (каналы socks:<профиль> от этого не зависят)
  echo off | sudo tee "$SOCKS_STATE" >/dev/null
  if ! exit_apply; then
    echo "  ${RED}✗ конфиг выхода на C2 не применился${R} — снимаю туннель, возврат на прямой C2"
    sudo bash -c "printf 'GLOBAL=c2\nGLOBAL_SOCKS=\n' > $GLOBAL_EXIT"
    vpn_off >/dev/null 2>&1
    return 1
  fi
  # Клиентский DNS в VPN-режиме → тоннельный шлюз (1-й pushed-DNS) через цепочку, чтобы у
  # КЛИЕНТОВ резолвер был резидентным (как у выхода), а не dnscrypt малины (Quad9/CF).
  # Берём ВСЕ пушнутые резолверы, а не первый: одиночный сервер через цепочку+туннель
  # даёт заметные потери UDP (в проде было retried 225 / failed 183 из 936), а на отвал
  # сетевого DNS телефоны отвечают уходом в СВОЙ шифрованный DNS — и страна DNS уезжает.
  local gws; gws="$(s2_exec "cat $C2_VPN_DIR/pushed-dns 2>/dev/null" | tr -d '\r' | awk 'NF{print $1}')"
  if [ -n "$gws" ]; then
    printf '%s\n' "$gws" | sudo tee /etc/gate/vpn-dns >/dev/null
    # все server= строки заменяем на пушнутые (по одной на резолвер)
    sudo sed -i '/^server=/d' /etc/dnsmasq.d/gate.conf
    printf 'server=%s\n' $gws | sudo tee -a /etc/dnsmasq.d/gate.conf >/dev/null
    sudo systemctl restart dnsmasq 2>/dev/null
    echo "→ Клиентский DNS → тоннельные резолверы: $(printf '%s ' $gws)(резидентные, как выход)"
  else
    sudo rm -f /etc/gate/vpn-dns
    echo "  ${YEL}⚠ pushed-DNS пуст — клиентский DNS остаётся на dnscrypt малины${R}"
  fi
  echo "→ Подстраиваю малину (routeOnly, QUIC, клиентский DNS в туннель)…"
  render_pi_apply; tproxy_active && sudo bash "$TPROXY_UP" >/dev/null 2>&1
  echo "Проверка…"; sleep 2; exit_status
}
vpn_off(){
  # Подчищаем БЕЗУСЛОВНО (идемпотентно): неудачный `on` мог оставить C2 в полусостоянии
  # (pppd/таблица 200/killswitch), а малину — в VPN-роутинге. Поэтому off всегда снимает
  # туннель, возвращает xray на direct и перерендеривает малину, даже если флаг уже off.
  if [ "$(cat "$VPN_STATE" 2>/dev/null)" = on ]; then
    echo "→ Опускаю VPN-выход, возврат на прямой выход C2…"
  else
    echo "→ VPN-выход не помечен активным — на всякий случай подчищаю C2 и малину…"
  fi
  s2_exec "gate-vpn down 2>/dev/null; echo VPNDOWN" >/dev/null 2>&1
  # Флаг снимаем ДО сборки. Конфиг выхода пересобирает ЕДИНЫЙ exit_apply: он уберёт vpn-out и
  # вернёт direct, но СОХРАНИТ включённый носок и полосы (раньше здесь свой инлайн-питон
  # затирал outbounds целиком и сносил socks-out вместе с VPN).
  echo off | sudo tee "$VPN_STATE" >/dev/null
  # Если глобальным выходом был этот туннель — возвращаем глобальный на прямой C2, иначе
  # exit_apply отправил бы ВСЕХ неназначенных в blocked (выход-то исчез).
  case "$(global_get)" in ovpn|pptp) sudo bash -c "printf 'GLOBAL=c2\nGLOBAL_SOCKS=\n' > $GLOBAL_EXIT" ;; esac
  exit_apply >/dev/null || echo "  ${YEL}⚠ конфиг выхода не применился — проверь gate exit${R}"
  # вернуть клиентский DNS на dnscrypt малины
  sudo rm -f /etc/gate/vpn-dns
  sudo sed -i "s|^server=.*|server=127.0.0.1#5300|" /etc/dnsmasq.d/gate.conf
  sudo systemctl restart dnsmasq 2>/dev/null
  echo "→ Возвращаю малину (клиентский DNS → dnscrypt)…"
  render_pi_apply; tproxy_active && sudo bash "$TPROXY_UP" >/dev/null 2>&1
}

exit_status(){  # ЕДИНЫЙ статус выхода цепочки (любой режим) — gate exit
  local cur; cur=$(active_exit)
  printf "\n%s┌─ Выход цепочки ───────────────────────────────%s\n" "$CYA" "$R"
  printf "%s│%s режим:  %s%s%s\n" "$CYA" "$R" "$GRN" "$(exit_label "$cur")" "$R"
  case "$cur" in
    ovpn|pptp)
      s2_exec "gate-vpn status 2>/dev/null" 2>/dev/null | while IFS= read -r l; do printf "%s│%s   %s\n" "$CYA" "$R" "$l"; done ;;
    socks)
      if [ -f "$SOCKS_CAPS" ]; then cap(){ grep -E "^$1=" "$SOCKS_CAPS" 2>/dev/null | cut -d= -f2; }
        printf "%s│%s   умеет: TCP=%s remote-DNS=%s UDP=%s\n" "$CYA" "$R" "$(cap TCP)" "$(cap RDNS)" "$(cap UDP)"; fi ;;
  esac
  local ip; ip=$(tunnel_exit_ip 8)
  printf "%s│%s выход:  %s%s%s\n" "$CYA" "$R" "$YEL" "${ip:-—}" "$R"
  printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"
}

vpn_status_one(){  # статус КОНКРЕТНОГО режима $1 (ovpn|pptp), метка $2
  local t="$1" lbl="$2" cur; cur=$(active_exit)
  printf "\n%s┌─ %s-выход ──────────────────────────────────%s\n" "$CYA" "$lbl" "$R"
  exit_has "$t" && printf "%s│%s конфиг: задан\n" "$CYA" "$R" || printf "%s│%s конфиг: %sне задан%s\n" "$CYA" "$R" "$YEL" "$R"
  if [ "$cur" = "$t" ]; then
    printf "%s│%s режим:  %sактивен%s\n" "$CYA" "$R" "$GRN" "$R"
    s2_exec "gate-vpn status 2>/dev/null" 2>/dev/null | while IFS= read -r l; do printf "%s│%s   %s\n" "$CYA" "$R" "$l"; done
    local ip; ip=$(tunnel_exit_ip 8); printf "%s│%s выход:  %s%s%s\n" "$CYA" "$R" "$YEL" "${ip:-—}" "$R"
  else
    printf "%s│%s режим:  выключен\n" "$CYA" "$R"
  fi
  printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"
}

vpn_test(){  # $1=ovpn|pptp — поднять интерфейс ИЗОЛИРОВАННО, curl через него, опустить
  local t="$1"
  exit_has "$t" || { echo "Нет $t-конфига. Сначала: gate $t set ..."; exit 1; }
  [ "$(cat "$VPN_STATE" 2>/dev/null)" = on ] && { echo "VPN-выход сейчас включён. Сначала gate exit off, потом test."; exit 1; }
  echo "→ Проба $t-выхода (поднимаю интерфейс, текущий выход не трогаю)…"
  local out ip
  out=$(s2_exec "echo $t > $C2_VPN_DIR/type; gate-vpn up >/dev/null 2>&1
dev=tun0; [ $t = pptp ] && dev=ppp0
xip=\$(curl -s --interface \$dev --max-time 12 https://api.ipify.org 2>/dev/null)
gate-vpn down >/dev/null 2>&1
echo EXITIP=\$xip")
  ip=$(printf '%s\n' "$out" | sed -n 's/^EXITIP=//p' | tr -d '\r')
  if [ -n "$ip" ]; then
    echo "  ${GRN}✓ $t работает${R}, выходной IP: ${YEL}$ip${R}"
    local geo; geo=$(s2_exec "curl -s --max-time 10 http://ip-api.com/line/$ip?fields=country,regionName,city,isp 2>/dev/null")
    [ -n "$geo" ] && echo "  гео: $(echo "$geo" | tr '\n' ' ')"
  else
    echo "  ${RED}✗ подключиться не вышло${R} (конфиг/сервер/креды; лог на C2: /var/log/gate-vpn.log)"
  fi
}

cmd_ovpn(){
  case "${1:-status}" in
    set) shift; ovpn_set "$@" ;;
    check) shift; ovpn_check "$@" ;;
    test) vpn_test ovpn ;;
    log)  s2_exec "tail -${2:-30} /var/log/gate-vpn.log 2>/dev/null" || echo "лог недоступен" ;;
    on|off) echo "Включение переехало: ${YEL}gate global ovpn ${1}${R}  ${D}(gate ovpn — только настройка)${R}" ;;
    status) vpn_status_one ovpn OpenVPN ;;
    *) echo "gate ovpn {set <файл.ovpn> [user] [pass]|check <файл.ovpn>|test|status|log [N]}"
       echo "  ${D}включить глобально: gate global ovpn on${R}" ;;
  esac
}
cmd_pptp(){
  case "${1:-status}" in
    set) shift; pptp_set "$@" ;;
    test) vpn_test pptp ;;
    on|off) echo "Включение переехало: ${YEL}gate global pptp ${1}${R}  ${D}(gate pptp — только настройка)${R}" ;;
    status) vpn_status_one pptp PPTP ;;
    *) echo "gate pptp {set <server> <user> <pass>|test|status}"
       echo "  ${D}включить глобально: gate global pptp on${R}" ;;
  esac
}
cmd_exit(){  # ЕДИНЫЙ статус/выключатель выхода — gate exit
  case "${1:-status}" in
    status|"") exit_status ;;
    off) exit_off_one "$(active_exit)" ;;
    *) echo "gate exit {status|off}" ;;
  esac
}

# ─── Команда: logs ─ просмотр/вкл/выкл логирования ────────────────────
# Флаги в /etc/gate/log.conf (TRAFFIC/PERF). Читает chain-render.py (traffic).
log_flag(){  # $1=ключ, $2=дефолт(off); вернуть значение флага (on/off)
  local v; v=$( { [ -f "$LOG_CONF" ] && grep -E "^$1=" "$LOG_CONF" 2>/dev/null | tail -1 | cut -d= -f2; } )
  echo "${v:-${2:-off}}"
}
log_set(){   # записать KEY=VALUE в log.conf (создать/заменить)
  sudo bash -c "
    mkdir -p /etc/gate; touch '$LOG_CONF'
    grep -v -E '^$1=' '$LOG_CONF' > '$LOG_CONF.tmp' 2>/dev/null || true
    echo '$1=$2' >> '$LOG_CONF.tmp'
    mv '$LOG_CONF.tmp' '$LOG_CONF'
    chown pi:pi '$LOG_CONF'
  "
}
# Перерендерить конфиг xray малины по текущим флагам и перезапустить
render_pi_apply(){
  local tmp; tmp="$(mktemp --suffix=.json)" || return 1
  python3 "$RENDER" pi "$CHAIN_JSON" > "$tmp" || { echo "  ✗ рендер pi не удался"; rm -f "$tmp"; return 1; }
  if command -v xray >/dev/null 2>&1; then
    # как root: xray при -test реально открывает access/error-логи (root-владелец /var/log/xray)
    sudo xray -test -config "$tmp" >/dev/null 2>&1 || { echo "  ✗ конфиг не прошёл xray -test"; rm -f "$tmp"; return 1; }
  fi
  sudo bash -c "cat '$tmp' > '$PI_XRAY_CONF'"; rm -f "$tmp"
  sudo systemctl restart "$XRAY_SVC"; sleep 1
}

cmd_logs(){
  local cat="${1:-status}"
  case "$cat" in
    xray)
      case "${2:-view}" in
        on)
          echo "→ Системный лог xray: warning (ошибки/предупреждения в journald)…"
          log_set XRAY on
          render_pi_apply && echo "  ${GRN}✓${R} xray log ON (loglevel warning)"
          ;;
        off)
          echo "→ Системный лог xray: полная тишина…"
          log_set XRAY off
          render_pi_apply && echo "  ${GRN}✓${R} xray log OFF (loglevel none)"
          ;;
        view) sudo journalctl -u "$XRAY_SVC" -n "${3:-50}" --no-pager ;;
        status) echo "xray: $(log_flag XRAY on) (loglevel $(python3 -c "import json;print(json.load(open('$PI_XRAY_CONF'))['log']['loglevel'])" 2>/dev/null))" ;;
        [0-9]*) sudo journalctl -u "$XRAY_SVC" -n "$2" --no-pager ;;   # back-compat: gate logs xray 50
        *) echo "gate logs xray {view [N]|on|off|status}" ;;
      esac
      ;;
    traffic)
      case "${2:-view}" in
        on)
          echo "→ Включаю лог соединений (xray access log)…"
          echo "  ${YEL}⚠ приватность:${R} будет видно, к каким адресам идут коннекты. Только для отладки."
          sudo bash -c 'mkdir -p /var/log/xray'
          log_set TRAFFIC on
          render_pi_apply && echo "  ${GRN}✓${R} traffic ON → $XRAY_ACCESS"
          ;;
        off)
          echo "→ Выключаю лог соединений…"
          log_set TRAFFIC off
          render_pi_apply && echo "  ${GRN}✓${R} traffic OFF (xray тихий: loglevel warning)"
          ;;
        view)
          if sudo test -s "$XRAY_ACCESS"; then sudo tail -n "${3:-50}" "$XRAY_ACCESS"
          else echo "Лог соединений пуст/выключен. Включить: gate logs traffic on"; fi
          ;;
        status) echo "traffic: $(log_flag TRAFFIC)";;
        *) echo "gate logs traffic {on|off|view|status}";;
      esac
      ;;
    perf)
      case "${2:-view}" in
        on)
          echo "→ Включаю мониторинг (CPU/RAM/темп/потери к C1, каждые 30с)…"
          log_set PERF on
          sudo systemctl enable --now "$PERF_SVC" >/dev/null 2>&1
          systemctl is-active --quiet "$PERF_SVC" \
            && echo "  ${GRN}✓${R} perf ON → $PERF_LOG" || echo "  ${RED}✗${R} служба не стартовала"
          ;;
        off)
          echo "→ Выключаю мониторинг…"
          log_set PERF off
          sudo systemctl disable --now "$PERF_SVC" >/dev/null 2>&1
          echo "  ${GRN}✓${R} perf OFF"
          ;;
        view)
          if [ -s "$PERF_LOG" ]; then tail -n "${3:-20}" "$PERF_LOG"
          else echo "Лог производительности пуст/выключен. Включить: gate logs perf on"; fi
          ;;
        status) echo "perf: $(log_flag PERF)  (служба: $(systemctl is-active "$PERF_SVC" 2>/dev/null))";;
        *) echo "gate logs perf {on|off|view|status}";;
      esac
      ;;
    off)
      cmd_logs traffic off
      cmd_logs perf off
      echo "${B}Тихий режим:${R} всё опциональное логирование выключено (бережём SD-карту)."
      ;;
    status|"")
      printf "%sЛогирование%s (тихо = бережём SD-карту)\n" "$B" "$R"
      printf "  traffic (соединения): %s%s%s  → %s\n" "$B" "$(log_flag TRAFFIC)" "$R" "$XRAY_ACCESS"
      printf "  perf (CPU/RAM/темп):  %s%s%s  → %s  [служба: %s]\n" "$B" "$(log_flag PERF)" "$R" "$PERF_LOG" "$(systemctl is-active "$PERF_SVC" 2>/dev/null)"
      printf "  xray (журнал):        %s%s%s  journald — смотреть: gate logs xray [N]\n" "$B" "$(log_flag XRAY on)" "$R"
      [ -f "$PERF_LOG" ] && printf "  размер perf-лога:     %s\n" "$(du -h "$PERF_LOG" 2>/dev/null | cut -f1)"
      sudo test -f "$XRAY_ACCESS" && printf "  размер access-лога:   %s\n" "$(sudo du -h "$XRAY_ACCESS" 2>/dev/null | cut -f1)"
      ;;
    *) echo "gate logs {status|xray [N]|traffic {on|off|view}|perf {on|off|view}|off}";;
  esac
}

# ─── Команда: profile ─ именованные профили носков/VPN ────────────────
# Хранятся НА малине (root-only, umask 077):
#   socks/<имя>.conf  (как socks.conf)   • pptp/<имя>.conf   • ovpn/<имя>/{client.ovpn,auth.txt}
# «use» переиспользует существующие сеттеры (cmd_socks set / pptp_set / ovpn_set):
# для ovpn это перезаливает .ovpn на C2 БЕЗ повторной ручной загрузки файла.
prof_name_ok(){ case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }

profile_list(){
  local types="${1:-socks pptp ovpn}" t d n
  for t in $types; do
    d="$PROFILE_DIR/$t"
    printf "%s%s%s:\n" "$B" "$t" "$R"
    n=""
    if sudo test -d "$d"; then
      case "$t" in
        ovpn) n="$(sudo ls -1 "$d" 2>/dev/null)";;
        *)    n="$(sudo ls -1 "$d" 2>/dev/null | sed 's/\.conf$//')";;
      esac
    fi
    if [ -n "$n" ]; then echo "$n" | sed 's/^/  /'; else echo "  ${D}(пусто)${R}"; fi
  done
}

profile_save(){
  local t="${1:-}" name="${2:-}"; shift 2 2>/dev/null || true
  prof_name_ok "$name" || { echo "Использование: gate profile save <socks|pptp|ovpn> <имя> ...  (имя: A-Za-z0-9._-)"; exit 1; }
  case "$t" in
    socks)
      local ip="${1:-}" port="${2:-}" user="${3:-}" pass="${4:-}"
      [ -n "$ip" ] && [ -n "$port" ] || { echo "gate profile save socks <имя> <ip> <port> [user] [pass]"; exit 1; }
      sudo mkdir -p "$PROFILE_DIR/socks"
      sudo bash -c "umask 077; cat > '$PROFILE_DIR/socks/$name.conf' <<EOF
SOCKS_IP=$ip
SOCKS_PORT=$port
SOCKS_USER=$user
SOCKS_PASS=$pass
EOF"
      echo "Профиль носка ${B}$name${R} сохранён.  Применить: gate profile use socks $name"
      ;;
    pptp)
      local srv="${1:-}" user="${2:-}" pass="${3:-}"
      [ -n "$srv" ] && [ -n "$user" ] && [ -n "$pass" ] || { echo "gate profile save pptp <имя> <server> <user> <pass>"; exit 1; }
      sudo mkdir -p "$PROFILE_DIR/pptp"
      sudo bash -c "umask 077; cat > '$PROFILE_DIR/pptp/$name.conf' <<EOF
PPTP_SERVER=$srv
PPTP_USER=$user
PPTP_PASS=$pass
EOF"
      echo "Профиль PPTP ${B}$name${R} сохранён.  Применить: gate profile use pptp $name"
      ;;
    ovpn)
      local f="${1:-}" user="${2:-}" pass="${3:-}"
      [ -f "$f" ] || { echo "Файл не найден: $f  (укажи путь к .ovpn на малине)"; exit 1; }
      sudo mkdir -p "$PROFILE_DIR/ovpn/$name"
      sudo bash -c "umask 077; cat '$f' > '$PROFILE_DIR/ovpn/$name/client.ovpn'"
      if [ -n "$user" ]; then
        sudo bash -c "umask 077; printf '%s\n%s\n' '$user' '$pass' > '$PROFILE_DIR/ovpn/$name/auth.txt'"
      else
        sudo rm -f "$PROFILE_DIR/ovpn/$name/auth.txt"
      fi
      echo "Профиль OpenVPN ${B}$name${R} сохранён (.ovpn скопирован — заново грузить не нужно)."
      echo "Применить: gate profile use ovpn $name"
      ;;
    *) echo "Тип: socks|pptp|ovpn"; exit 1 ;;
  esac
}

profile_use(){
  local t="${1:-}" name="${2:-}"
  prof_name_ok "$name" || { echo "Использование: gate profile use <socks|pptp|ovpn> <имя>"; exit 1; }
  case "$t" in
    socks)
      local p="$PROFILE_DIR/socks/$name.conf"
      sudo test -f "$p" || { echo "Нет профиля носка '$name'  (список: gate profile list socks)"; exit 1; }
      local SOCKS_IP="" SOCKS_PORT="" SOCKS_USER="" SOCKS_PASS=""
      eval "$(sudo cat "$p")"
      cmd_socks set "$SOCKS_IP" "$SOCKS_PORT" "$SOCKS_USER" "$SOCKS_PASS"
      ;;
    pptp)
      local p="$PROFILE_DIR/pptp/$name.conf"
      sudo test -f "$p" || { echo "Нет профиля PPTP '$name'  (список: gate profile list pptp)"; exit 1; }
      local PPTP_SERVER="" PPTP_USER="" PPTP_PASS=""
      eval "$(sudo cat "$p")"
      pptp_set "$PPTP_SERVER" "$PPTP_USER" "$PPTP_PASS"
      ;;
    ovpn)
      local d="$PROFILE_DIR/ovpn/$name"
      sudo test -f "$d/client.ovpn" || { echo "Нет профиля OpenVPN '$name'  (список: gate profile list ovpn)"; exit 1; }
      local u="" pw=""
      if sudo test -f "$d/auth.txt"; then
        u="$(sudo sed -n 1p "$d/auth.txt")"; pw="$(sudo sed -n 2p "$d/auth.txt")"
      fi
      ovpn_set "$d/client.ovpn" "$u" "$pw"
      ;;
    *) echo "gate profile use <socks|pptp|ovpn> <имя>"; exit 1 ;;
  esac
}

profile_rm(){
  local t="${1:-}" name="${2:-}"
  prof_name_ok "$name" || { echo "Использование: gate profile rm <socks|pptp|ovpn> <имя>"; exit 1; }
  case "$t" in
    socks) sudo rm -f  "$PROFILE_DIR/socks/$name.conf" ;;
    pptp)  sudo rm -f  "$PROFILE_DIR/pptp/$name.conf" ;;
    ovpn)  sudo rm -rf "$PROFILE_DIR/ovpn/$name" ;;
    *) echo "gate profile rm <socks|pptp|ovpn> <имя>"; exit 1 ;;
  esac
  echo "Профиль $t/$name удалён."
}

cmd_profile(){
  local sub="${1:-list}"; shift 2>/dev/null || true
  case "$sub" in
    list|ls)        profile_list "$@" ;;
    save|add)       profile_save "$@" ;;
    use|load)       profile_use "$@" ;;
    rm|del|delete)  profile_rm "$@" ;;
    *) echo "gate profile {list [тип] | save <тип> <имя> ... | use <тип> <имя> | rm <тип> <имя>}";;
  esac
}

# ─── Команда: wipe ─ очистка профилей/стейта на малине + кред на C2 ───
cmd_wipe(){
  if [ "${GATE_YES:-0}" != "1" ]; then
    printf "%s⚠ Очистка%s удалит: ВСЕ профили, текущий носок/VPN-конфиг на малине и затрёт креды/конфиги VPN на C2.\n" "$YEL" "$R"
    printf "Для подтверждения набери %swipe%s: " "$B" "$R"
    local ans=""; read -r ans
    [ "$ans" = "wipe" ] || { echo "Отменено."; exit 0; }
  fi
  echo "→ Выключаю активный выход (fail-safe → прямой режим)…"
  local act; act="$(active_exit 2>/dev/null)"; [ -n "$act" ] && exit_off_one "$act" 2>/dev/null || true
  echo "→ Чищу профили и конфиги на малине…"
  sudo rm -rf "$PROFILE_DIR"
  sudo rm -f "$SOCKS_CONF" "$SOCKS_CAPS" "$VPN_META" /etc/gate/vpn-dns
  echo "→ Затираю креды/конфиги VPN на выходном хопе (C2, через цепочку)…"
  if s2_exec "rm -rf '$C2_VPN_DIR'/client.ovpn '$C2_VPN_DIR'/auth.txt '$C2_VPN_DIR'/pushed-dns /etc/ppp/peers/gate-vpn; sed -i '/ gate-pptp /d' /etc/ppp/chap-secrets 2>/dev/null; echo WIPED" 2>/dev/null | grep -q WIPED; then
    echo "  ${GRN}✓${R} C2 очищен"
  else
    echo "  ${YEL}⚠${R} C2 недоступен — удалённую часть пропустил (повтори при живой цепочке)"
  fi
  echo "${GRN}✓${R} Готово. Малина в прямом режиме, профили пусты."
}

# ─── Команда: web ─ локальная веб-панель (LAN-only, пароль) ───────────
WEB_PY="/usr/local/bin/gate-web.py"
# Самодостаточность: на любой малине, куда долили gate+gate-web.py, «gate web on»
# сам доставит systemd-юнит (если нет) и заведёт удобное имя http://gate в dnsmasq.
web_ensure_installed(){
  if ! sudo test -f /etc/systemd/system/gate-web.service; then
    sudo bash -c 'cat > /etc/systemd/system/gate-web.service <<UNIT
[Unit]
Description=gate — локальная веб-панель управления (LAN-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/gate-web.py serve
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
UNIT'
    sudo systemctl daemon-reload
  fi
  # http://gate → AP-адрес малины (отдельный файл, чтобы не трогать managed gate.conf)
  local apaddr="${AP_ADDR:-192.168.50.1}" dconf=/etc/dnsmasq.d/gate-web.conf
  if ! sudo test -f "$dconf" || ! sudo grep -q '^address=/gate/' "$dconf" 2>/dev/null; then
    echo "address=/gate/$apaddr" | sudo tee "$dconf" >/dev/null
    sudo systemctl restart dnsmasq 2>/dev/null || true
  fi
}
cmd_web(){
  case "${1:-status}" in
    passwd|password)
      local pw="${2:-}"
      if [ -z "$pw" ]; then
        read -rsp "Новый пароль веб-панели: " pw; echo
        local pw2; read -rsp "Повтори пароль: " pw2; echo
        [ "$pw" = "$pw2" ] || { echo "${RED}Пароли не совпали${R}"; exit 1; }
      fi
      [ -n "$pw" ] || { echo "Пустой пароль"; exit 1; }
      printf '%s' "$pw" | sudo python3 "$WEB_PY" passwd-stdin || exit 1
      echo "Включить панель: gate web on"
      ;;
    on)
      if ! sudo test -f /etc/gate/web.conf || ! sudo grep -q '^PASS_HASH=' /etc/gate/web.conf 2>/dev/null; then
        echo "${YEL}Сначала задай пароль:${R} gate web passwd"; exit 1
      fi
      web_ensure_installed
      sudo systemctl enable --now gate-web >/dev/null 2>&1
      if systemctl is-active --quiet gate-web; then
        local port; port="$(sudo grep -E '^PORT=' /etc/gate/web.conf 2>/dev/null | cut -d= -f2)"; port="${port:-8088}"
        echo "${GRN}✓${R} Панель включена: ${B}http://gate:$port${R} (или http://192.168.50.1:$port) — только из локалки"
      else
        echo "${RED}✗${R} служба не стартовала — смотри: gate web log"
      fi
      ;;
    off)
      sudo systemctl disable --now gate-web >/dev/null 2>&1
      echo "${GRN}✓${R} Панель выключена."
      ;;
    restart) sudo systemctl restart gate-web && echo "${GRN}✓${R} перезапущена" ;;
    log)     sudo journalctl -u gate-web -n "${2:-30}" --no-pager ;;
    status|"")
      local act port
      act="$(systemctl is-active gate-web 2>/dev/null)"
      port="$(sudo grep -E '^PORT=' /etc/gate/web.conf 2>/dev/null | cut -d= -f2)"; port="${port:-8088}"
      printf "Веб-панель: %s%s%s" "$B" "$act" "$R"
      sudo grep -q '^PASS_HASH=' /etc/gate/web.conf 2>/dev/null && printf "  (пароль задан)" || printf "  ${YEL}(пароль НЕ задан)${R}"
      printf "\n  адрес: http://gate:%s  •  http://192.168.50.1:%s  (LAN-only)\n" "$port" "$port"
      ;;
    *) echo "gate web {passwd [пароль]|on|off|restart|status|log [N]}" ;;
  esac
}

