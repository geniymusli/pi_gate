#!/usr/bin/env bash
#
# gate — панель управления privacy-роутером (Raspberry Pi)
# Управляет источником WAN (Ethernet / встроенный Wi-Fi), AP и показывает статус.
# Статус туннеля (WG/VLESS/padding) дописывается по мере настройки этих компонентов.
#
set -uo pipefail
GATE_VERSION="0.14s"

# ─── Конфиг ───────────────────────────────────────────────────────────
# Переопредели в /etc/gate/gate.conf при необходимости.
WAN_ETH="eth0"        # Ethernet от провайдера
WAN_WIFI="wlan0"      # встроенный Wi-Fi (клиент к чужой сети)
AP_IFACE="wlan1"      # USB Wi-Fi адаптер (раздача, всегда AP)
WG_IFACE="wg0"        # WireGuard интерфейс
XRAY_SVC="xray"       # имя systemd-сервиса xray
PADDING_SVC="gate-padding"  # имя systemd-сервиса padding
EXIT_CHECK_URL="https://api.ipify.org"  # проверка выходного IP
DHCP_LEASES="/var/lib/misc/dnsmasq.leases"  # файл аренд dnsmasq

# ─── Параметры туннеля (TPROXY data plane, WG убран) ──────────────────
AP_SUBNET="192.168.50.0/24"  # подсеть AP (твои устройства)
TPROXY_PORT="12345"          # дефолт-фолбэк; реальный порт берётся из chain.json (см. ниже)
SOCKS_TEST="127.0.0.1:10808" # дефолт-фолбэк; порт из chain.json socks_test_port (см. ниже)
TPROXY_UP="/usr/local/bin/gate-tproxy-up.sh"
TPROXY_DOWN="/usr/local/bin/gate-tproxy-down.sh"

# ─── Цепочка и управление (источник правды: chain.json) ───────────────
# Модель управления — ПРЯМАЯ сетка: ключ малины (mgmt_key из chain.json) добавлен
# в root@authorized_keys на КАЖДОМ хопе, малина дотягивается до любого напрямую.
# Цепочку разворачивает/правит визард: gate setup.
CHAIN_JSON="/etc/gate/chain.json"
RENDER="/usr/local/bin/chain-render.py"  # рендерер конфигов и SSH-цепочки
MGMT_KEY="${HOME:-/home/pi}/.ssh/gate_to_s1"    # дефолт; реальный берётся из chain.json
EXIT_XRAY_CONF="/usr/local/etc/xray/config.json"  # путь конфига xray на выходном хопе
PI_XRAY_CONF="/usr/local/etc/xray/config.json"    # конфиг xray самой малины
SOCKS_CONF="/etc/gate/socks.conf"        # параметры носка (хранятся на малине)
SOCKS_STATE="/etc/gate/socks.state"      # on/off — режим носка (читает chain-render)
SOCKS_CAPS="/etc/gate/socks.caps"        # TCP/RDNS/UDP=ok|fail — возможности носка
VPN_STATE="/etc/gate/vpn.state"          # on/off — режим VPN-выхода (читает chain-render)
VPN_META="/etc/gate/vpn.conf"            # TYPE=ovpn|pptp
C2_VPN_DIR="/etc/gate/vpn"               # каталог конфигов VPN НА выходном хопе
PROFILE_DIR="/etc/gate/profiles"         # именованные профили носков/VPN (на малине, root-only)
VPN_SCRIPT="/usr/local/share/gate/gate-vpn"  # C2-side скрипт (стейджится на малине)
DNS_FALLBACK_STATE="/etc/gate/dns-fallback.state"  # on/off — запасной DNS, если туннель свой не дал
DNS_FALLBACK_SERVERS="1.1.1.1 8.8.8.8"   # по явному запросу: Cloudflare+Google «в крайнем случае»
DNSCRYPT_TOML="/etc/dnscrypt-proxy/dnscrypt-proxy.toml"  # резолвер малины (прямой выход)
OSFP_SCRIPT="/usr/local/share/gate/gate-osfp"      # C2-side контроллер OS-спуфа (стейджится на малине)
OSFP_PY="/usr/local/share/gate/gate-osfp.py"       # C2-side хендлер NFQUEUE (стейджится на малине)

# Порты — единый источник правды chain.json (пишется при gate setup). Дефолты выше = фолбэк
# на случай отсутствия chain.json (свежая малина). Совпадают с тем, что рендерит chain-render.py.
if [ -f "$CHAIN_JSON" ]; then
  eval "$(python3 - "$CHAIN_JSON" <<'PY' 2>/dev/null
import json,sys
try: c=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
tp=c.get("tproxy_port"); st=c.get("socks_test_port")
if tp: print('TPROXY_PORT="%s"' % tp)
if st: print('SOCKS_TEST="127.0.0.1:%s"' % st)
PY
)"
fi

# ─── Логирование ──────────────────────────────────────────────────────
LOG_CONF="/etc/gate/log.conf"            # флаги логирования (TRAFFIC=, PERF=)
XRAY_ACCESS="/var/log/xray/access.log"   # лог соединений малины (traffic)
PERF_LOG="/var/log/gate-monitor.log"     # лог производительности (perf)
PERF_SVC="gate-monitor"                  # systemd-сервис perf-мониторинга

[ -f /etc/gate/gate.conf ] && . /etc/gate/gate.conf

# ─── Цвета ────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'
  GRN=$'\e[32m'; RED=$'\e[31m'; YEL=$'\e[33m'; CYA=$'\e[36m'; GRY=$'\e[90m'
else
  B=""; D=""; R=""; GRN=""; RED=""; YEL=""; CYA=""; GRY=""
fi

ok(){ printf "%sok%s"   "$GRN" "$R"; }
no(){ printf "%s—%s"    "$GRY" "$R"; }
bad(){ printf "%sdown%s" "$RED" "$R"; }

# ─── Хелперы ──────────────────────────────────────────────────────────
iface_ip(){ ip -4 -o addr show "$1" 2>/dev/null | awk '{print $4}' | head -n1; }
iface_up(){ [ "$(cat /sys/class/net/$1/operstate 2>/dev/null)" = "up" ]; }
has_carrier(){ [ "$(cat /sys/class/net/$1/carrier 2>/dev/null)" = "1" ]; }
svc_active(){ systemctl is-active --quiet "$1" 2>/dev/null; }
default_dev(){ ip route show default 2>/dev/null | awk '{print $5; exit}'; }
# выходной IP цепочки (через socks-test → reality-s1 → C1 → C2).
# В tproxy-режиме свой трафик малины НЕ перехватывается, поэтому проверяем
# выход через локальный socks, а не через --interface.
tunnel_exit_ip(){ curl -s --max-time "${1:-8}" --socks5-hostname "$SOCKS_TEST" "$EXIT_CHECK_URL" 2>/dev/null; }
# tproxy поднят, если есть и ip rule (fwmark 1 → table 100), и цепочка GATE_TP
tproxy_active(){
  ip -4 rule show 2>/dev/null | grep -q 'fwmark 0x1 lookup 100' && \
  sudo iptables -t mangle -S GATE_TP >/dev/null 2>&1
}

# ─── Цепочка: чтение chain.json и прямое управление выходным хопом ─────
chain_ready(){ [ -f "$CHAIN_JSON" ]; }
chain_get(){ python3 -c "import json;c=json.load(open('$CHAIN_JSON'));print($1)" 2>/dev/null; }
mgmt_key(){ local k; k="$(chain_get "c.get('mgmt_key','')")"; [ -n "$k" ] && echo "$k" || echo "$MGMT_KEY"; }
exit_host(){ chain_get "c['hops'][-1]['host']"; }
exit_name(){ chain_get "c['hops'][-1].get('name','exit')"; }

# мгновенная скорость на интерфейсе (мбит/с, по rx/tx за 1с)
iface_rate(){
  local i="$1" rx1 tx1 rx2 tx2
  rx1=$(cat /sys/class/net/$i/statistics/rx_bytes 2>/dev/null || echo 0)
  tx1=$(cat /sys/class/net/$i/statistics/tx_bytes 2>/dev/null || echo 0)
  sleep 1
  rx2=$(cat /sys/class/net/$i/statistics/rx_bytes 2>/dev/null || echo 0)
  tx2=$(cat /sys/class/net/$i/statistics/tx_bytes 2>/dev/null || echo 0)
  awk -v a=$rx1 -v b=$rx2 -v c=$tx1 -v d=$tx2 \
    'BEGIN{printf "↓%.1f ↑%.1f мбит/с", (b-a)*8/1e6, (d-c)*8/1e6}'
}

# ─── Команда: info ────────────────────────────────────────────────────
cmd_info(){
  local wan_dev; wan_dev=$(default_dev)
  local sec="${CYA}${B}" hr="${CYA}├───────────────────────────────────────────────${R}"

  printf "\n${CYA}┌─ ${B}gate${R}${CYA} · privacy-роутер ────────────────────────${R}\n"

  # ── ПОДКЛЮЧЕНИЕ ──
  printf "${CYA}│${R} ${sec}ПОДКЛЮЧЕНИЕ${R}\n"
  if [ "$wan_dev" = "$WAN_ETH" ]; then
    printf "${CYA}│${R}   ${D}WAN${R}      Ethernet (%s)  %s\n" "$WAN_ETH" "$(iface_ip $WAN_ETH)"
    printf "${CYA}│${R}   ${D}MAC${R}      %s\n" "$(cat /sys/class/net/$WAN_ETH/address 2>/dev/null)"
  elif [ -n "$WAN_WIFI" ] && [ "$wan_dev" = "$WAN_WIFI" ]; then
    local ssid; ssid=$(iw dev $WAN_WIFI link 2>/dev/null | awk -F': ' '/SSID/{print $2}')
    printf "${CYA}│${R}   ${D}WAN${R}      Wi-Fi «%s» (%s)  %s\n" "${ssid:-?}" "$WAN_WIFI" "$(iface_ip $WAN_WIFI)"
    printf "${CYA}│${R}   ${D}MAC${R}      %s\n" "$(cat /sys/class/net/$WAN_WIFI/address 2>/dev/null)"
  else
    printf "${CYA}│${R}   ${D}WAN${R}      %s нет маршрута\n" "$(no)"
  fi
  printf "${CYA}│${R}   ${D}наружу${R}   "
  curl -s --max-time 6 -o /dev/null "$EXIT_CHECK_URL" 2>/dev/null && printf "%s\n" "$(ok)" || printf "%s\n" "$(bad)"

  printf "%s\n" "$hr"
  # ── РАЗДАЧА ──
  printf "${CYA}│${R} ${sec}РАЗДАЧА${R}\n"
  printf "${CYA}│${R}   ${D}AP${R}       "
  if svc_active hostapd; then
    local apssid apch
    apssid=$(awk -F= '/^ssid=/{print $2}' /etc/hostapd/hostapd.conf 2>/dev/null)
    apch=$(awk -F= '/^channel=/{print $2}' /etc/hostapd/hostapd.conf 2>/dev/null)
    printf "%s  «%s» ch%s (%s)\n" "$(ok)" "${apssid:-?}" "${apch:-?}" "$AP_IFACE"
    printf "${CYA}│${R}   ${D}MAC${R}      %s\n" "$(cat /sys/class/net/$AP_IFACE/address 2>/dev/null)"
  else
    printf "%s раздача выключена\n" "$(bad)"
  fi
  printf "${CYA}│${R}   ${D}клиенты${R}  "
  local clients; clients=$(iw dev $AP_IFACE station dump 2>/dev/null | grep -c "^Station")
  [ "${clients:-0}" -gt 0 ] && printf "%s%s подключено%s\n" "$GRN" "$clients" "$R" || printf "%sнет%s\n" "$GRY" "$R"

  printf "%s\n" "$hr"
  # ── ТУННЕЛЬ ──
  printf "${CYA}│${R} ${sec}ТУННЕЛЬ${R}\n"
  printf "${CYA}│${R}   ${D}tproxy${R}   "
  tproxy_active && printf "%s → :%s → Reality\n" "$(ok)" "$TPROXY_PORT" || printf "%s опущен (fail-closed)\n" "$(bad)"
  printf "${CYA}│${R}   ${D}xray${R}     "
  svc_active "$XRAY_SVC" && printf "%s\n" "$(ok)" || printf "%s не запущен\n" "$(no)"
  printf "${CYA}│${R}   ${D}padding${R}  "
  svc_active "$PADDING_SVC" && printf "%s constant-rate\n" "$(ok)" || printf "%s выключен\n" "$(no)"
  printf "${CYA}│${R}   ${D}выход${R}    %s%s%s\n" "$GRN" "$(exit_label "$(active_exit)")" "$R"

  printf "%s\n" "$hr"
  # ── Exit IP ──
  local exit_ip; exit_ip=$(tunnel_exit_ip 6)
  printf "${CYA}│${R}   ${D}Exit IP${R}  %s%s%s ${D}(куда смотрит наблюдатель)${R}\n" "$YEL" "${exit_ip:-не определён}" "$R"
  printf "${CYA}└───────────────────────────────────────────────${R}\n"
  printf "  ${D}живой трафик:${R} ${GRN}gate traffic${R}\n\n"
}

# ─── Команда: traffic ─ живой монитор скорости (до Ctrl+C) ────────────
_rxb(){ cat "/sys/class/net/$1/statistics/rx_bytes" 2>/dev/null || echo 0; }
_txb(){ cat "/sys/class/net/$1/statistics/tx_bytes" 2>/dev/null || echo 0; }
cmd_traffic(){
  local dev="${1:-$(default_dev)}"
  [ -n "$dev" ] && [ -d "/sys/class/net/$dev" ] || { echo "Нет интерфейса «$dev». Использование: gate traffic [iface]"; exit 1; }
  trap 'printf "\n"; exit 0' INT
  printf "${CYA}Живой трафик${R} на ${B}%s${R}  ${D}— Ctrl+C для выхода${R}\n" "$dev"
  local rx0 tx0 rx1 tx1 rx2 tx2 down up pd=0 pu=0
  rx0=$(_rxb "$dev"); tx0=$(_txb "$dev"); rx1=$rx0; tx1=$tx0
  while true; do
    sleep 1
    rx2=$(_rxb "$dev"); tx2=$(_txb "$dev")
    down=$(awk -v a="$rx1" -v b="$rx2" 'BEGIN{printf "%.1f",(b-a)*8/1e6}')
    up=$(awk   -v a="$tx1" -v b="$tx2" 'BEGIN{printf "%.1f",(b-a)*8/1e6}')
    pd=$(awk -v p="$pd" -v c="$down" 'BEGIN{print (c>p)?c:p}')
    pu=$(awk -v p="$pu" -v c="$up"   'BEGIN{print (c>p)?c:p}')
    local td tu; td=$(awk -v a="$rx0" -v b="$rx2" 'BEGIN{printf "%.1f",(b-a)/1048576}')
    tu=$(awk -v a="$tx0" -v b="$tx2" 'BEGIN{printf "%.1f",(b-a)/1048576}')
    printf "\r\033[K  ${GRN}↓%7s${R} ${YEL}↑%7s${R} ${D}Мбит/с${R}   ${D}пик${R} ↓%s ↑%s   ${D}сессия${R} ↓%sМБ ↑%sМБ" \
      "$down" "$up" "$pd" "$pu" "$td" "$tu"
    rx1=$rx2; tx1=$tx2
  done
}

# ─── Команда: wan ─────────────────────────────────────────────────────
# Есть ли ОТДЕЛЬНЫЙ радиомодуль под WAN-Wi-Fi (не тот, что раздаёт)? Если под
# раздачу отдан встроенный wlan0 (нет USB-свистка), WAN_WIFI пуст (или = AP) —
# свободного радио нет, WAN только по кабелю. Тогда gate wan wifi / gate wifi
# вежливо отказывают, а gate wan auto никогда не сваливается в wifi.
wifi_wan_available(){ [ -n "$WAN_WIFI" ] && [ "$WAN_WIFI" != "$AP_IFACE" ]; }
no_wifi_wan_msg(){
  echo "Встроенный Wi-Fi отдан под раздачу (AP=$AP_IFACE) — отдельного радиомодуля"
  echo "под WAN-Wi-Fi нет. Интернет принимается только по кабелю: gate wan eth."
  echo "Нужен wifi-WAN — воткни USB-Wi-Fi адаптер и переустанови (он станет AP, wlan0 освободится)."
}

# Выключить встроенный Wi-Fi (wlan0): снять автоконнект со ВСЕХ Wi-Fi-клиент-
# соединений (wlan1=AP вне NM не трогается) и отключить устройство. Иначе NM
# снова поднимет wlan0 → второй default-маршрут → чехарда и обрывы.
wifi_disable(){
  wifi_wan_available || return 0   # нет отдельного Wi-Fi под WAN — нечего выключать
  nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2 ~ /wireless/{print $1}' | while read -r c; do
    sudo nmcli connection modify "$c" connection.autoconnect no 2>/dev/null
  done
  sudo nmcli device disconnect "$WAN_WIFI" >/dev/null 2>&1
}

# ─── Команда: wan ─ только выбор «какой интерфейс является WAN» ─────────
cmd_wan(){
  local sub="${1:-show}"
  case "$sub" in
    eth)
      echo "→ WAN ← Ethernet ($WAN_ETH); встроенный Wi-Fi выключаю полностью…"
      wifi_disable
      sudo nmcli device connect "$WAN_ETH" >/dev/null 2>&1
      sleep 2; cmd_wan show
      ;;
    wifi)
      wifi_wan_available || { no_wifi_wan_msg; exit 1; }
      # Сделать WAN = wlan0 по УЖЕ сохранённой сети (подключиться к новой: gate wifi connect).
      echo "→ WAN ← встроенный Wi-Fi ($WAN_WIFI)…"
      sudo nmcli device connect "$WAN_WIFI" >/dev/null 2>&1
      sleep 2
      local con; con=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$WAN_WIFI" '$2==d{print $1; exit}')
      if [ -n "$con" ]; then
        sudo nmcli connection modify "$con" connection.autoconnect yes 2>/dev/null
      else
        echo "  (нет сохранённой сети на $WAN_WIFI — подключись: gate wifi connect \"SSID\" пароль)"
      fi
      cmd_wan show
      ;;
    auto)
      if has_carrier "$WAN_ETH"; then
        echo "→ Кабель есть → Ethernet"; cmd_wan eth
      elif wifi_wan_available; then
        echo "→ Кабеля нет → встроенный Wi-Fi"; cmd_wan wifi
      else
        echo "→ Кабеля нет, а wifi-WAN недоступен (одна радиокарта) → остаюсь на Ethernet ($WAN_ETH)"
        cmd_wan eth
      fi
      ;;
    show|"")
      local dev; dev=$(default_dev)
      printf "Текущий WAN: "
      case "$dev" in
        "$WAN_ETH")  printf "%sEthernet%s (%s) %s\n" "$GRN" "$R" "$WAN_ETH" "$(iface_ip $WAN_ETH)";;
        "$WAN_WIFI") printf "%sWi-Fi%s (%s) %s\n"     "$GRN" "$R" "$WAN_WIFI" "$(iface_ip $WAN_WIFI)";;
        *)           printf "%sне определён%s\n" "$RED" "$R";;
      esac
      ;;
    *) echo "gate wan {eth|wifi|auto|show}";;
  esac
}

# ─── Команда: wifi ─ всё про встроенный Wi-Fi-клиент (wlan0) ───────────
cmd_wifi(){
  local sub="${1:-show}"
  wifi_wan_available || { no_wifi_wan_msg; exit 1; }
  case "$sub" in
    connect)
      local ssid="${2:-}" pass="${3:-}"
      if [ -z "$ssid" ]; then echo "Использование: gate wifi connect \"SSID\" [пароль]"; exit 1; fi
      echo "→ Подключаю встроенный Wi-Fi ($WAN_WIFI) к «$ssid» (станет WAN)…"
      if [ -n "$pass" ]; then
        sudo nmcli device wifi connect "$ssid" password "$pass" ifname "$WAN_WIFI"
      else
        sudo nmcli device wifi connect "$ssid" ifname "$WAN_WIFI"
      fi
      # включить автоконнект активного соединения wlan0 (для переездов)
      local con; con=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$WAN_WIFI" '$2==d{print $1; exit}')
      [ -n "$con" ] && sudo nmcli connection modify "$con" connection.autoconnect yes 2>/dev/null
      sleep 2; cmd_wifi show
      ;;
    scan)
      echo "→ Сканирую сети на $WAN_WIFI…"
      nmcli device wifi rescan ifname "$WAN_WIFI" >/dev/null 2>&1; sleep 2
      nmcli -f SSID,SIGNAL,SECURITY device wifi list ifname "$WAN_WIFI"
      ;;
    disconnect)
      echo "→ Выключаю встроенный Wi-Fi ($WAN_WIFI)…"
      wifi_disable
      cmd_wifi show
      ;;
    mac)
      # MAC встроенного Wi-Fi через NetworkManager; переживает реконнекты.
      local con; con=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null \
        | awk -F: -v d="$WAN_WIFI" '$2==d{print $1; exit}')
      case "${2:-show}" in
        random)
          if [ -z "$con" ]; then echo "Нет активного Wi-Fi соединения на $WAN_WIFI"; exit 1; fi
          echo "→ Случайный MAC при каждом подключении для «$con»…"
          nmcli connection modify "$con" wifi.cloned-mac-address random
          nmcli connection up "$con" >/dev/null 2>&1
          echo "Текущий MAC: $(cat /sys/class/net/$WAN_WIFI/address)"
          ;;
        reset)
          [ -z "$con" ] && { echo "Нет активного Wi-Fi соединения"; exit 1; }
          nmcli connection modify "$con" wifi.cloned-mac-address permanent
          nmcli connection up "$con" >/dev/null 2>&1
          echo "MAC сброшен на заводской: $(cat /sys/class/net/$WAN_WIFI/address)"
          ;;
        show|"")
          echo "MAC $WAN_WIFI: $(cat /sys/class/net/$WAN_WIFI/address 2>/dev/null)"
          [ -n "$con" ] && echo "Режим: $(nmcli -g 802-11-wireless.cloned-mac-address connection show "$con" 2>/dev/null)" || true
          ;;
        *)
          if [[ "${2}" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]; then
            [ -z "$con" ] && { echo "Нет активного Wi-Fi соединения"; exit 1; }
            nmcli connection modify "$con" wifi.cloned-mac-address "${2}"
            nmcli connection up "$con" >/dev/null 2>&1
            echo "MAC задан: $(cat /sys/class/net/$WAN_WIFI/address)"
          else
            echo "Формат: gate wifi mac {random|aa:bb:cc:dd:ee:ff|reset}"; exit 1
          fi
          ;;
      esac
      ;;
    show|"")
      local ssid; ssid=$(iw dev "$WAN_WIFI" link 2>/dev/null | awk -F': ' '/SSID/{print $2}')
      if [ -n "$ssid" ]; then
        printf "Wi-Fi (%s): подключён к «%s» %s\n" "$WAN_WIFI" "$ssid" "$(iface_ip $WAN_WIFI)"
      else
        printf "Wi-Fi (%s): не подключён\n" "$WAN_WIFI"
      fi
      echo "MAC: $(cat /sys/class/net/$WAN_WIFI/address 2>/dev/null)"
      ;;
    *) echo "gate wifi {connect \"SSID\" [pass]|scan|disconnect|mac ...|show}";;
  esac
}

# Найти NM-соединение, привязанное к eth0 (активное или по interface-name).
eth_con(){
  local c
  c=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null \
      | awk -F: -v d="$WAN_ETH" '$2==d{print $1; exit}')
  if [ -z "$c" ]; then
    while IFS=: read -r name typ; do
      [ "$typ" = "802-3-ethernet" ] || continue
      [ "$(nmcli -g connection.interface-name connection show "$name" 2>/dev/null)" = "$WAN_ETH" ] \
        && { c="$name"; break; }
    done < <(nmcli -t -f NAME,TYPE connection show 2>/dev/null)
  fi
  printf '%s' "$c"
}

# ─── Команда: eth ─ всё про Ethernet-WAN (eth0) ───────────────────────
cmd_eth(){
  local sub="${1:-show}"
  case "$sub" in
    mac) shift; cmd_eth_mac "${1:-show}" ;;
    show|"")
      if has_carrier "$WAN_ETH"; then
        printf "Ethernet (%s): link up %s\n" "$WAN_ETH" "$(iface_ip $WAN_ETH)"
      else
        printf "Ethernet (%s): кабель не подключён\n" "$WAN_ETH"
      fi
      echo "MAC: $(cat /sys/class/net/$WAN_ETH/address 2>/dev/null)"
      ;;
    *) echo "gate eth {mac ...|show}";;
  esac
}

# ─── MAC Ethernet-WAN (eth0) через NetworkManager. Переживает реконнекты.
cmd_eth_mac(){
  local action="${1:-show}"
  local con; con=$(eth_con)
  case "$action" in
    random)
      [ -z "$con" ] && { echo "Не найдено NM-соединение для $WAN_ETH"; exit 1; }
      echo "→ Случайный MAC при каждом подключении $WAN_ETH («$con»)…"
      sudo nmcli connection modify "$con" ethernet.cloned-mac-address random
      sudo nmcli connection up "$con" >/dev/null 2>&1; sleep 1
      echo "Текущий MAC: $(cat /sys/class/net/$WAN_ETH/address)"
      ;;
    reset)
      [ -z "$con" ] && { echo "Не найдено NM-соединение для $WAN_ETH"; exit 1; }
      sudo nmcli connection modify "$con" ethernet.cloned-mac-address permanent
      sudo nmcli connection up "$con" >/dev/null 2>&1; sleep 1
      echo "MAC сброшен на заводской: $(cat /sys/class/net/$WAN_ETH/address)"
      ;;
    show|"")
      echo "MAC $WAN_ETH: $(cat /sys/class/net/$WAN_ETH/address 2>/dev/null)"
      local perm; perm=$(ethtool -P "$WAN_ETH" 2>/dev/null | awk '{print $NF}')
      [ -n "$perm" ] && [ "$perm" != "00:00:00:00:00:00" ] && echo "Заводской:   $perm"
      [ -n "$con" ] && echo "Режим:       $(nmcli -g 802-3-ethernet.cloned-mac-address connection show "$con" 2>/dev/null)" || true
      ;;
    *)
      if [[ "$action" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]; then
        [ -z "$con" ] && { echo "Не найдено NM-соединение для $WAN_ETH"; exit 1; }
        sudo nmcli connection modify "$con" ethernet.cloned-mac-address "$action"
        sudo nmcli connection up "$con" >/dev/null 2>&1; sleep 1
        echo "MAC задан: $(cat /sys/class/net/$WAN_ETH/address)"
      else
        echo "Формат: gate eth mac {random|aa:bb:cc:dd:ee:ff|reset}"; exit 1
      fi
      ;;
  esac
}

# ─── Команда: ap ──────────────────────────────────────────────────────
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"

# случайный locally-administered unicast MAC (первый октет 02)
rand_mac(){ printf '02:%02x:%02x:%02x:%02x:%02x' \
  $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)); }

ap_set_mac(){
  local mac="$1"
  echo "→ Меняю MAC $AP_IFACE на $mac…"
  sudo systemctl stop hostapd
  sudo ip link set dev "$AP_IFACE" down
  sudo ip link set dev "$AP_IFACE" address "$mac"
  sudo ip link set dev "$AP_IFACE" up
  sudo systemctl start hostapd
  echo "Текущий MAC: $(cat /sys/class/net/$AP_IFACE/address)"
}

cmd_ap(){
  case "${1:-show}" in
    on)    sudo systemctl start hostapd dnsmasq; echo "AP запущена";;
    off)   sudo systemctl stop hostapd; echo "AP остановлена";;
    restart)  sudo systemctl restart hostapd dnsmasq; echo "AP перезапущена";;

    iface)
      # Сменить интерфейс РАЗДАЧИ уже после установки (докупил USB-свисток / убрал его).
      # Делает то же, что установщик: hostapd/dnsmasq/override/NM-unmanaged/gate.conf + рестарт.
      local newif="${2:-}"
      if [ -z "$newif" ]; then
        echo "Использование: gate ap iface <интерфейс>   (сейчас AP=$AP_IFACE)"
        echo "Wi-Fi адаптеры: $(for d in /sys/class/net/*/wireless; do basename "$(dirname "$d")"; done 2>/dev/null | tr '\n' ' ')"
        exit 1
      fi
      [ -e "/sys/class/net/$newif" ] || { echo "нет интерфейса $newif"; exit 1; }
      [ -e "/sys/class/net/$newif/wireless" ] || { echo "$newif — не Wi-Fi (для AP нужен беспроводной)"; exit 1; }
      [ "$newif" = "$WAN_ETH" ] && { echo "$newif — это WAN-кабель, нельзя под раздачу"; exit 1; }
      [ "$newif" = "$AP_IFACE" ] && { echo "AP уже на $newif"; exit 0; }
      if [ "$newif" = "$WAN_WIFI" ] && [ "$(default_dev)" = "$WAN_WIFI" ]; then
        echo "$newif сейчас несёт интернет (WAN-Wi-Fi). Переведи WAN на кабель: gate wan eth"; exit 1
      fi
      local oldif="$AP_IFACE" apaddr="${AP_ADDR:-192.168.50.1}" new_wan_wifi
      case "$newif" in wlan0) new_wan_wifi="";; *) new_wan_wifi="wlan0";; esac
      echo "→ Переношу раздачу: $oldif → $newif…"
      sudo rfkill unblock wifi 2>/dev/null || true
      sudo sed -i "s/^interface=.*/interface=$newif/" "$HOSTAPD_CONF"
      sudo sed -i "s/^interface=.*/interface=$newif/" /etc/dnsmasq.d/gate.conf
      sudo install -d /etc/systemd/system/hostapd.service.d
      sudo tee /etc/systemd/system/hostapd.service.d/override.conf >/dev/null <<APOV
[Unit]
Wants=network.target
After=network.target
[Service]
ExecStartPre=/sbin/ip addr flush dev $newif
ExecStartPre=/sbin/ip addr add $apaddr/24 dev $newif
ExecStartPre=/sbin/ip link set $newif up
APOV
      sudo tee /etc/NetworkManager/conf.d/99-gate-unmanaged.conf >/dev/null <<NMEOF
[keyfile]
unmanaged-devices=interface-name:$newif
NMEOF
      sudo sed -i "s/^AP_IFACE=.*/AP_IFACE=\"$newif\"/; s/^WAN_WIFI=.*/WAN_WIFI=\"$new_wan_wifi\"/" /etc/gate/gate.conf
      sudo systemctl stop hostapd 2>/dev/null
      sudo ip addr flush dev "$oldif" 2>/dev/null || true          # снять AP-IP со старого
      sudo nmcli device set "$newif" managed no  2>/dev/null || true
      sudo nmcli device set "$oldif" managed yes 2>/dev/null || true   # старый — обратно под NM
      sudo systemctl daemon-reload
      sudo systemctl restart NetworkManager 2>/dev/null || true
      sleep 1
      sudo systemctl restart hostapd dnsmasq 2>/dev/null
      sleep 1
      if svc_active hostapd; then
        echo "  ✓ раздача теперь на $newif (WAN-Wi-Fi: ${new_wan_wifi:-нет, только кабель})"
        [ -n "$WAN_WIFI" ] && [ -z "$new_wan_wifi" ] && echo "  (wlan0 занят раздачей — интернет только по кабелю)"
        [ -z "$WAN_WIFI" ] && [ -n "$new_wan_wifi" ] && echo "  (освободился wlan0 — теперь можно gate wan wifi)"
        echo "  туннель под новый интерфейс: gate tunnel restart"
      else
        echo "  ✗ hostapd не поднялся на $newif — sudo journalctl -u hostapd -n 30"
        echo "    иногда нужен reboot (если интерфейс держал wpa_supplicant)"
      fi
      ;;

    ssid)
      local new="${2:-}"
      [ -z "$new" ] && { echo "Использование: gate ap ssid \"Новое имя\""; exit 1; }
      sudo sed -i "s/^ssid=.*/ssid=$new/" "$HOSTAPD_CONF"
      sudo systemctl restart hostapd
      echo "SSID → «$new» (AP перезапущена)"
      ;;

    pass|password)
      local new="${2:-}"
      [ -z "$new" ] && { echo "Использование: gate ap pass \"новый_пароль\""; exit 1; }
      if [ "${#new}" -lt 8 ]; then echo "Пароль WPA2 должен быть ≥8 символов"; exit 1; fi
      sudo sed -i "s/^wpa_passphrase=.*/wpa_passphrase=$new/" "$HOSTAPD_CONF"
      sudo systemctl restart hostapd
      echo "Пароль изменён (AP перезапущена)"
      ;;

    mac)
      case "${2:-show}" in
        random) ap_set_mac "$(rand_mac)";;
        reset)
          local perm; perm=$(ethtool -P "$AP_IFACE" 2>/dev/null | awk '{print $NF}')
          [ -z "$perm" ] && { echo "Не удалось определить заводской MAC"; exit 1; }
          ap_set_mac "$perm"; echo "(сброшен на заводской)"
          ;;
        show|"") echo "MAC $AP_IFACE: $(cat /sys/class/net/$AP_IFACE/address)";;
        *)
          if [[ "${2}" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]; then
            ap_set_mac "${2}"
          else
            echo "Неверный MAC. Формат: aa:bb:cc:dd:ee:ff | random | reset | show"; exit 1
          fi
          ;;
      esac
      ;;

    show|*)
      printf "AP (%s): " "$AP_IFACE"
      svc_active hostapd && printf "%s\n" "$(ok)" || printf "%s\n" "$(bad)"
      printf "SSID:    %s\n" "$(awk -F= '/^ssid=/{print $2}' $HOSTAPD_CONF 2>/dev/null)"
      printf "MAC:     %s\n" "$(cat /sys/class/net/$AP_IFACE/address 2>/dev/null)"
      printf "Клиентов: %s\n" "$(iw dev $AP_IFACE station dump 2>/dev/null | grep -c '^Station')"
      ;;
  esac
}

# ─── Команда: clients ─────────────────────────────────────────────────
# Показывает подключённые устройства: IP, MAC, имя, сигнал, время аренды.
# Источники: dnsmasq leases (IP/имя) + hostapd station dump (кто реально в эфире).
cmd_clients(){
  # MAC-адреса станций, реально ассоциированных с AP прямо сейчас
  local assoc; assoc=$(iw dev "$AP_IFACE" station dump 2>/dev/null | awk '/^Station/{print tolower($2)}')

  printf "\n%s┌─ Клиенты на %s ──────────────────────────────────%s\n" "$CYA" "$AP_IFACE" "$R"
  printf "%s│%s %-15s %-17s %-16s %s\n" "$CYA" "$R" "IP" "MAC" "Имя" "Статус"
  printf "%s├──────────────────────────────────────────────────────────%s\n" "$CYA" "$R"

  if [ ! -f "$DHCP_LEASES" ]; then
    printf "%s│%s файл аренд не найден: %s\n" "$CYA" "$R" "$DHCP_LEASES"
    printf "%s└──────────────────────────────────────────────────────────%s\n\n" "$CYA" "$R"
    return
  fi

  local found=0
  # формат dnsmasq.leases: <expiry> <mac> <ip> <hostname> <clientid>
  while read -r exp mac ip name _; do
    [ -z "$ip" ] && continue
    found=1
    local low; low=$(printf '%s' "$mac" | tr 'A-Z' 'a-z')
    local status sig
    if printf '%s\n' "$assoc" | grep -q "$low"; then
      # сигнал из station dump
      sig=$(iw dev "$AP_IFACE" station dump 2>/dev/null \
            | awk -v m="$low" 'BEGIN{IGNORECASE=1} /^Station/{cur=tolower($2)} /signal:/{if(cur==m){print $2" dBm"; exit}}')
      status="${GRN}online${R} ${D}${sig}${R}"
    else
      status="${GRY}offline${R}"
    fi
    printf "%s│%s %-15s %-17s %-16s %b\n" "$CYA" "$R" "$ip" "$mac" "${name:-—}" "$status"
  done < "$DHCP_LEASES"

  [ "$found" = "0" ] && printf "%s│%s %sнет активных аренд%s\n" "$CYA" "$R" "$GRY" "$R"

  printf "%s└──────────────────────────────────────────────────────────%s\n" "$CYA" "$R"
  printf "%s%s online%s — в эфире сейчас, %soffline%s — есть аренда, но не подключён\n\n" \
    "$D" "$GRN" "$R$D" "$GRY" "$R"
}

# ─── Каналы: персональный выход для устройства ────────────────────────
# Зачем: ноут прямым C2, один телефон через OpenVPN, второй — через свой носок. Одновременно.
# Как (детали в chain-render.py): у reality-inbound КАЖДОГО хопа помимо основной идентичности
# заведён ПУЛ безымянных каналов (lane_uuids: 1,2,3…, email lane-1, lane-2…). Канал сам по
# себе ничего не значит — это просто отдельная труба сквозь цепочку. Чем труба заканчивается
# (прямой C2 / tun0 / КОНКРЕТНЫЙ носок), решает ТОЛЬКО конфиг выхода C2 (exit_apply).
# Поэтому подключить второй носок = поменять конфиг C2, БЕЗ передеплоя C1 и без новых uuid.
# Малина раскидывает клиентов по каналам по source-IP; неназначенные идут основной
# идентичностью и получают ГЛОБАЛЬНЫЙ выход (gate global …).
# Привязка к MAC, а IP закрепляется бронью dnsmasq — иначе после переподключения телефон
# получил бы другой адрес и тихо ушёл на глобальный выход.
CLIENT_LANES="/etc/gate/client-lanes.conf"     # <MAC> <IP> <канал> <выход> [имя]
# Свои подписи устройствам: <MAC> <подпись с пробелами>. Отдельно от раскладки полос,
# потому что подписать хочется и НЕназначенное устройство, а имя из DHCP часто пустое
# или бесполезное (у iPhone с приватным адресом его вообще нет).
CLIENT_NAMES="/etc/gate/client-names.conf"
LANES_DHCP="/etc/dnsmasq.d/gate-lanes.conf"    # брони IP + ПЕРСОНАЛЬНЫЙ резолвер каждой полосе
# Резолвер для полос, чей выход НЕ туннель (прямой C2, носок). Плейн-DNS, но он едет
# ВНУТРИ цепочки до выхода — снаружи виден только IP выхода, как у обычного юзера.
# Для полосы vpn резолверы берём из /etc/gate/vpn-dns (их пушит сам VPN-сервер).
# ВАЖНО: публичные резолверы — anycast, и «страна резолвера» зависит от того, откуда к нему
# пришли. С одного и того же выхода Quad9 может отвечать Швецией, Cloudflare — Нидерландами,
# а Google — страной выхода. Поэтому резолвер полосы ПОДБИРАЕТСЯ ЗАМЕРОМ и настраивается:
#   gate dns lane <выход> <ip[,ip]>     (выход: c2 | socks:<профиль>)
LANE_DNS_CONF="/etc/gate/lane-dns.conf"        # строки: <выход> <ip[,ip]>
# Адрес, на котором dnscrypt обслуживает КЛИЕНТОВ полосы прямого C2 (шифрованный DoH).
# ВНЕ AP-подсети и вне AP-интерфейса СПЕЦИАЛЬНО: dnsmasq поднят с bind-interfaces и занимает
# ВСЕ адреса wlan1 — вторичный адрес на нём отобрал бы у него порт 53 и dnsmasq не стартовал.
# Держим его на lo: клиент шлёт на 10.53.0.1, пакет уходит на шлюз (малину), а у неё адрес
# локальный → дойдёт до dnscrypt. Приватные адреса tproxy пропускает мимо туннеля.
AP_DNS_ADDR="${AP_DNS_ADDR:-10.53.0.1}"
LANE_DNS_DEFAULT="${LANE_DNS_DEFAULT:-9.9.9.9,149.112.112.112}"

# Резолверы конкретной полосы: явная настройка → пушнутые (для vpn) → дефолт
lane_dns_for(){
  local tgt="$1" v
  v="$(awk -v t="$tgt" '!/^#/ && $1==t {print $2; exit}' "$LANE_DNS_CONF" 2>/dev/null)"
  [ -n "$v" ] && { printf '%s' "$v"; return; }
  case "$tgt" in
    vpn) paste -sd, /etc/gate/vpn-dns 2>/dev/null ;;
    c2)  printf '%s' "$AP_DNS_ADDR" ;;   # dnscrypt малины, выход — прямой C2 (см. lanes_self_route)
    *)   printf '%s' "$LANE_DNS_DEFAULT" ;;
  esac
}

# dnscrypt должен слушать и на AP_DNS_ADDR:53, иначе клиенты полосы C2 до него не достучатся.
# Две тонкости:
#  • сервис бежит под _dnscrypt-proxy и НЕ может занять порт <1024 → выдаём ровно одну
#    привилегию CAP_NET_BIND_SERVICE (не root!);
#  • адрес вторичный и появляется позже (его ставит gate-tproxy-up.sh) → разрешаем
#    ip_nonlocal_bind, иначе на буте гонка «сервис стартовал раньше адреса» = FATAL.
dnscrypt_listen_ensure(){
  local t="$DNSCRYPT_TOML" d=/etc/systemd/system/dnscrypt-proxy.service.d/20-gate-bind.conf
  sudo test -f "$t" || return 0
  local changed=0
  if ! grep -q "$AP_DNS_ADDR:53" "$t" 2>/dev/null; then
    sudo sed -i "s|^listen_addresses = \[\(.*\)\]|listen_addresses = [\1, '$AP_DNS_ADDR:53']|" "$t"
    changed=1
  fi
  # И на loopback:53 — это резолвер САМОЙ малины. Раньше она спрашивала dnsmasq, а тот
  # ходит к резолверам глобального выхода; когда трафик малины поехал каналом C2, её
  # запросы к «американскому» резолверу туннеля перестали доходить (он обслуживает только
  # своих) → у малины пропал DNS. Теперь она резолвит через свой dnscrypt, тем же путём,
  # каким сама выходит. 127.0.0.2 всегда существует и не зависит от AP-интерфейса.
  if ! grep -q "127.0.0.2:53" "$t" 2>/dev/null; then
    sudo sed -i "s|^listen_addresses = \[\(.*\)\]|listen_addresses = [\1, '127.0.0.2:53']|" "$t"
    changed=1
  fi
  # резолвер малины → её dnscrypt (NetworkManager пишет resolv.conf)
  if ! grep -q "servers=127.0.0.2" /etc/NetworkManager/conf.d/00-gate-dns.conf 2>/dev/null; then
    printf '# Резолвер САМОЙ малины = её dnscrypt (шифрованный, выходит той же полосой).\n[global-dns-domain-*]\nservers=127.0.0.2\n' \
      | sudo tee /etc/NetworkManager/conf.d/00-gate-dns.conf >/dev/null
    sudo systemctl reload-or-restart NetworkManager >/dev/null 2>&1 || true
    printf 'nameserver 127.0.0.2\n' | sudo tee /etc/resolv.conf >/dev/null
  fi
  if [ ! -f "$d" ]; then
    sudo install -d /etc/systemd/system/dnscrypt-proxy.service.d
    printf '[Service]\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\n' \
      | sudo tee "$d" >/dev/null
    sudo systemctl daemon-reload
    changed=1
  fi
  sudo sysctl -qw net.ipv4.ip_nonlocal_bind=1 2>/dev/null || true
  grep -qs ip_nonlocal_bind /etc/sysctl.d/99-gate-tproxy.conf 2>/dev/null || \
    echo "net.ipv4.ip_nonlocal_bind=1" | sudo tee -a /etc/sysctl.d/99-gate-tproxy.conf >/dev/null
  [ "$changed" = 1 ] && sudo systemctl restart dnscrypt-proxy 2>/dev/null
  return 0
}

# Собственный трафик малины (а значит и её dnscrypt) отправляем в канал ПРЯМОГО C2.
# Иначе он идёт основной идентичностью → глобальным выходом: при global=ovpn резолвер
# видел бы американский IP туннеля, и DNS полосы C2 палил бы связь с VPN.
# Запись помечаем mac=self — она только для роутинга, в DHCP не попадает.
lanes_self_route(){
  local ch ip
  ch="$(lane_rows | awk '$4=="c2" && $1!="self" {print $3; exit}')"
  sudo sed -i '/^self[[:space:]]/d' "$CLIENT_LANES" 2>/dev/null
  [ -n "$ch" ] || return 0
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)"
  [ -n "$ip" ] || return 0
  echo "self $ip $ch c2 (малина)" | sudo tee -a "$CLIENT_LANES" >/dev/null
}
GLOBAL_EXIT="/etc/gate/global-exit.conf"       # GLOBAL=c2|ovpn|pptp|socks  GLOBAL_SOCKS=<профиль>

# Каналы готовы, только если пул есть у ВСЕХ хопов
lanes_enabled(){
  python3 -c "
import json,sys
try: h=json.load(open('$CHAIN_JSON'))['hops']
except Exception: sys.exit(1)
if not h: sys.exit(1)
ch=set((h[0].get('lane_uuids') or {}).keys())
for x in h: ch &= set(k for k,v in (x.get('lane_uuids') or {}).items() if v)
sys.exit(0 if ch else 1)" 2>/dev/null
}
lanes_pool(){   # сколько каналов в пуле
  python3 -c "
import json
try:
    h=json.load(open('$CHAIN_JSON'))['hops']
    ch=set((h[0].get('lane_uuids') or {}).keys())
    for x in h: ch &= set(k for k,v in (x.get('lane_uuids') or {}).items() if v)
    print(len(ch))
except Exception: print(0)" 2>/dev/null
}
# Строки назначений (без комментариев)
lane_rows(){ grep -E '^[^#]' "$CLIENT_LANES" 2>/dev/null || true; }
lane_any_count(){ local n; n="$(lane_rows | grep -c . 2>/dev/null)"; printf '%s' "${n:-0}"; }
lane_of(){        # выход устройства по MAC (не назначено → пусто = глобальный)
  local m; m="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  lane_rows | awk -v m="$m" 'tolower($1)==m {print $4; exit}'
}
lane_ch_of(){     # канал устройства по MAC
  local m; m="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  lane_rows | awk -v m="$m" 'tolower($1)==m {print $3; exit}'
}
lane_ch_for_exit(){  # канал, уже занятый под этот выход (переиспользуем — одна труба на выход)
  lane_rows | awk -v e="$1" '$4==e {print $3; exit}'
}
lane_free_ch(){   # наименьший свободный канал пула; пусто, если все заняты
  local used; used="$(lane_rows | awk '{print $3}' | sort -u)"
  python3 -c "
import json,sys
h=json.load(open('$CHAIN_JSON'))['hops']
ch=set((h[0].get('lane_uuids') or {}).keys())
for x in h: ch &= set(k for k,v in (x.get('lane_uuids') or {}).items() if v)
used=set(sys.stdin.read().split())
free=sorted(ch-used, key=lambda x:(0,int(x)) if x.isdigit() else (1,x))
print(free[0] if free else '')" <<<"$used" 2>/dev/null
}
# Выравнивание колонок по СИМВОЛАМ: printf в bash считает байты, а кириллица — 2 байта
# на символ, из-за чего таблица с русскими подписями разъезжается.
pad(){ local s="$1" w="$2" n sp
  n="$(LC_ALL=C.UTF-8 printf '%s' "$s" | LC_ALL=C.UTF-8 wc -m 2>/dev/null || printf '%s' "${#s}")"
  sp=$(( w - n )); [ "$sp" -lt 1 ] && sp=1
  printf '%s%*s' "$s" "$sp" ""
}

client_label(){   # своя подпись по MAC (пусто, если не задана)
  local m; m="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  awk -v m="$m" '!/^#/ && tolower($1)==m {$1=""; sub(/^[ \t]+/,""); print; exit}' \
    "$CLIENT_NAMES" 2>/dev/null
}
client_label_set(){   # $1=MAC, дальше подпись (пусто = снять)
  local m; m="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"; shift
  local lbl="$*"
  sudo touch "$CLIENT_NAMES"
  sudo sed -i "/^$m[[:space:]]/Id" "$CLIENT_NAMES"
  [ -n "$lbl" ] && printf '%s %s\n' "$m" "$lbl" | sudo tee -a "$CLIENT_NAMES" >/dev/null
  return 0
}
# Как показывать устройство: своя подпись → имя из DHCP → прочерк
client_show(){    # $1=MAC $2=имя_из_аренды
  local l; l="$(client_label "$1")"
  if [ -n "$l" ]; then printf '%s' "$l"
  elif [ -n "${2:-}" ] && [ "$2" != "*" ]; then printf '%s' "$2"
  else printf '—'; fi
}

lane_find(){      # $1 = IP | MAC | своя подпись | имя из DHCP  →  "MAC IP ИМЯ"
  local q; q="$(printf '%s' "$1" | tr 'A-Z' 'a-z')" m=""
  # сперва по своей подписи (её юзер и держит в голове)
  m="$(awk -v q="$q" '!/^#/ {mac=$1; $1=""; sub(/^[ \t]+/,""); if (tolower($0)==q) {print tolower(mac); exit}}' \
       "$CLIENT_NAMES" 2>/dev/null)"
  if [ -n "$m" ]; then
    awk -v m="$m" '{if(tolower($2)==m){print tolower($2)" "$3" "$4; exit}}' "$DHCP_LEASES" 2>/dev/null
    return
  fi
  awk -v q="$q" '{if(tolower($2)==q||$3==q||($4!=""&&tolower($4)==q)){print tolower($2)" "$3" "$4; exit}}' \
    "$DHCP_LEASES" 2>/dev/null
}
# Человеческая подпись выхода: c2 | vpn | socks:<профиль>
exit_label_spec(){ case "${1:-}" in
    c2|"")   printf 'прямой C2' ;;
    vpn)     printf 'VPN-туннель на C2' ;;
    socks:*) printf 'носок «%s»' "${1#socks:}" ;;
    *)       printf '%s' "$1" ;;
  esac; }
# Доступен ли выход прямо сейчас (для предупреждений и fail-closed)
exit_spec_live(){ case "${1:-}" in
    c2|"")   true ;;
    vpn)     [ "$(cat "$VPN_STATE" 2>/dev/null)" = on ] ;;
    socks:*) [ -f "$PROFILE_DIR/socks/${1#socks:}.conf" ] ;;
    *) false ;;
  esac; }
# Проверка, что выход можно назначить (профиль носка существует и т.п.)
exit_spec_ok(){ case "${1:-}" in
    c2|vpn) return 0 ;;
    socks:*)
      local n="${1#socks:}"
      [ -n "$n" ] || { echo "  ${RED}✗ не указан профиль:${R} socks:<имя>  (список: ${YEL}gate profile list socks${R})"; return 1; }
      sudo test -f "$PROFILE_DIR/socks/$n.conf" || {
        echo "  ${RED}✗ нет профиля носка «$n»${R}"
        echo "     ${D}создать:${R} gate profile save socks $n <ip> <port> [user] [pass]"
        echo "     ${D}список:${R}  gate profile list socks"; return 1; }
      return 0 ;;
    *) echo "Куда: ${GRN}c2${R} · ${YEL}vpn${R} · ${YEL}socks:<профиль>${R}"; return 1 ;;
  esac; }

global_get(){ [ -f "$GLOBAL_EXIT" ] && . "$GLOBAL_EXIT" 2>/dev/null; printf '%s' "${GLOBAL:-c2}"; }
global_socks_prof(){ [ -f "$GLOBAL_EXIT" ] && . "$GLOBAL_EXIT" 2>/dev/null; printf '%s' "${GLOBAL_SOCKS:-}"; }
global_label(){ case "$(global_get)" in
    ovpn) printf 'OpenVPN (tun0 на C2)' ;;
    pptp) printf 'PPTP (ppp0 на C2)' ;;
    socks) printf 'носок «%s»' "$(global_socks_prof)" ;;
    *) printf 'прямой C2' ;;
  esac; }

lane_list(){
  printf "\n%s┌─ Выход по устройствам ────────────────────────────────────%s\n" "$CYA" "$R"
  printf "%s│%s глобальный выход: %s%s%s   %s(gate global …)%s\n" "$CYA" "$R" "$GRN" "$(global_label)" "$R" "$D" "$R"
  if lanes_enabled; then
    printf "%s│%s каналы: %s  %sзанято %s из %s%s\n" "$CYA" "$R" "$(ok)" "$D" \
      "$(lane_rows | awk '{print $3}' | sort -u | grep -c . 2>/dev/null || true)" "$(lanes_pool)" "$R"
  else
    printf "%s│%s каналы: %s не созданы — %sgate lanes init%s\n" "$CYA" "$R" "$(bad)" "$YEL" "$R"
  fi
  printf "%s├───────────────────────────────────────────────────────────%s\n" "$CYA" "$R"
  printf "%s│%s %s%s%s%s\n" "$CYA" "$R" "$(pad IP 16)" "$(pad MAC 19)" "$(pad Подпись 16)" "Выход"
  local any=0 mac ip name e c lbl
  while read -r _ mac ip name _; do
    [ -z "$ip" ] && continue
    any=1; e="$(lane_of "$mac")"; lbl="$(client_show "$mac" "$name")"
    if [ -z "$e" ]; then
      printf "%s│%s %s%s%s%s%s%s\n" "$CYA" "$R" "$(pad "$ip" 16)" "$(pad "$mac" 19)" "$(pad "$lbl" 16)" \
        "$D" "по умолчанию → $(global_label)" "$R"
    else
      exit_spec_live "$e" && c="$GRN" || c="$RED"
      printf "%s│%s %s%s%s%s%s%s%s\n" "$CYA" "$R" "$(pad "$ip" 16)" "$(pad "$mac" 19)" "$(pad "$lbl" 16)" \
        "$c" "$(exit_label_spec "$e")" "$R" \
        "$(exit_spec_live "$e" || printf ' %s(выход выключен → трафик блокирован)%s' "$YEL" "$R")"
    fi
  done < "$DHCP_LEASES" 2>/dev/null
  [ "$any" = 0 ] && printf "%s│%s %sнет аренд — подключи устройство к AP%s\n" "$CYA" "$R" "$GRY" "$R"
  printf "%s└───────────────────────────────────────────────────────────%s\n" "$CYA" "$R"
  printf "%s  назначить: gate client <ip|mac|подпись> exit c2|vpn|socks:<профиль>%s\n" "$D" "$R"
  printf "%s  подписать: gate client <ip|mac> name <как назвать>%s\n" "$D" "$R"
  printf "%s  вернуть на глобальный: gate client <…> exit auto%s\n\n" "$D" "$R"
}

# Пересобрать раздачу DHCP для назначенных устройств: закрепление IP + СВОЙ резолвер.
# Зачем свой резолвер: DNS должен уходить ТОЙ ЖЕ полосой, что и трафик, иначе страна
# резолвера не совпадает с выходом (ноут на C2 ходил бы с DNS американского провайдера).
# Запросы этих клиентов НЕ заворачиваются в локальный dnsmasq (см. gate-tproxy-up.sh):
# они идут в свою полосу и наружу выходят её выходом — резолвер видит именно его.
lanes_dhcp_write(){
  {
    echo "# Пишет gate client — не править руками (перезаписывается)"
    local mac ip ch tgt name dns
    while read -r mac ip ch tgt name; do
      [ -n "$mac" ] || continue
      [ "$mac" = self ] && continue    # служебная запись роутинга, не устройство
      dns="$(lane_dns_for "$tgt")"
      echo "dhcp-host=$mac,$ip,set:lane$ch"
      [ -n "$dns" ] && echo "dhcp-option=tag:lane$ch,option:dns-server,$dns"
    done < <(lane_rows)
  } | sudo tee "$LANES_DHCP" >/dev/null
}

cmd_client(){
  case "${1:-list}" in ""|list|status) lane_list; return 0 ;; esac
  local who="$1" verb="${2:-}" val="${3:-}"
  # подпись устройства: gate client <кто> name <как назвать>   (без слов — снять подпись)
  if [ "$verb" = name ]; then
    local f; f="$(lane_find "$who")"
    [ -n "$f" ] || { echo "Не нашёл '$who' среди аренд DHCP — посмотри ${YEL}gate clients${R}"; return 1; }
    local m; m="$(printf '%s' "$f" | awk '{print $1}')"
    shift 2
    client_label_set "$m" "$@"
    if [ -n "$*" ]; then echo "Подпись: ${GRN}$*${R}  ${D}($m)${R}"
    else echo "Подпись снята ${D}($m)${R}"; fi
    return 0
  fi
  [ "$verb" = exit ] && [ -n "$val" ] || {
    echo "gate client {list | <ip|mac|подпись> exit <c2|vpn|socks:профиль|auto> | <ip|mac> name <подпись>}"; return 1; }
  local found; found="$(lane_find "$who")"
  [ -n "$found" ] || { echo "Не нашёл '$who' среди аренд DHCP — посмотри ${YEL}gate clients${R}"; return 1; }
  local mac ip name
  mac="$(printf '%s' "$found" | awk '{print $1}')"
  ip="$(printf '%s' "$found"  | awk '{print $2}')"
  name="$(printf '%s' "$found"| awk '{print $3}')"
  name="$(client_show "$mac" "$name")"
  sudo touch "$CLIENT_LANES" "$LANES_DHCP"
  local before; before="$(lane_any_count)"
  if [ "$val" = auto ] || [ "$val" = default ]; then
    sudo sed -i "/^$mac[[:space:]]/d" "$CLIENT_LANES"
    echo "→ ${GRN}${name:-$mac}${R} ($ip) → по умолчанию (${GRN}$(global_label)${R})"
  else
    exit_spec_ok "$val" || return 1
    lanes_enabled || { echo "  ${RED}✗ каналы не созданы${R} — сначала: ${YEL}gate lanes init${R}"; return 1; }
    # Канал под этот выход переиспользуем, если он уже занят другим устройством:
    # одна труба на выход, устройств в ней сколько угодно — экономит пул.
    local ch; ch="$(lane_ch_for_exit "$val")"
    if [ -z "$ch" ]; then
      # временно убираем свою старую строку, чтобы освободить её канал под переиспользование
      sudo sed -i "/^$mac[[:space:]]/d" "$CLIENT_LANES"
      ch="$(lane_ch_for_exit "$val")"
      [ -n "$ch" ] || ch="$(lane_free_ch)"
      [ -n "$ch" ] || { echo "  ${RED}✗ свободных каналов нет${R} (пул: $(lanes_pool))"
                        echo "     ${D}увеличить:${R} gate lanes init <сколько>"; return 1; }
    fi
    sudo sed -i "/^$mac[[:space:]]/d" "$CLIENT_LANES"
    echo "$mac $ip $ch $val ${name:-—}" | sudo tee -a "$CLIENT_LANES" >/dev/null
    echo "→ ${YEL}${name:-$mac}${R} ($ip) → ${YEL}$(exit_label_spec "$val")${R} ${D}(канал $ch)${R}; адрес закреплён"
  fi
  dnscrypt_listen_ensure; lanes_self_route; lanes_dhcp_write
  sudo systemctl restart dnsmasq 2>/dev/null
  echo "→ Применяю на малине…"
  render_pi_apply || return 1
  # tproxy знает, чьи :53 пускать в свою полосу мимо локального резолвера
  tproxy_active && sudo bash "$TPROXY_UP" >/dev/null 2>&1
  echo "→ Пересобираю конфиг выхода на C2…"
  exit_apply >/dev/null || echo "  ${YEL}⚠ конфиг выхода не применился — проверь gate exit${R}"
  if [ "$val" != auto ] && [ "$val" != default ] && ! exit_spec_live "$val"; then
    echo "  ${YEL}⚠ выход «$(exit_label_spec "$val")» сейчас недоступен${R} — трафик устройства"
    echo "     ${D}блокируется (fail-closed, чтобы не утёк мимо назначенного выхода).${R}"
    [ "$val" = vpn ] && echo "     ${D}поднять:${R} ${YEL}gate global ovpn on${R} ${D}(или pptp)${R}"
  fi
  echo "Готово. Проверить: ${YEL}gate client list${R}"
}

# ─── Команда: global ─ выход по умолчанию для ВСЕХ неназначенных ──────
# gate global                 — показать
# gate global off             — вернуть всех на прямой C2
# gate global ovpn|pptp on    — поднять туннель на C2 и сделать его выходом по умолчанию
# gate global socks on [проф] — включить носок как выход по умолчанию
cmd_global(){
  local sub="${1:-status}"
  case "$sub" in
    ""|status|show)
      printf "\nГлобальный выход: ${GRN}$(global_label)${R}\n"
      printf "  ${D}назначено персонально: $(lane_any_count) устройств (gate client list)${R}\n"
      printf "  ${D}сменить: gate global {ovpn|pptp|socks [профиль]} on   ·   вернуть: gate global off${R}\n\n"
      ;;
    off)
      echo "→ Глобальный выход → прямой C2…"
      local cur; cur="$(global_get)"
      sudo bash -c "printf 'GLOBAL=c2\nGLOBAL_SOCKS=\n' > $GLOBAL_EXIT"
      echo off | sudo tee "$SOCKS_STATE" >/dev/null
      case "$cur" in
        ovpn|pptp)
          # туннель гасим, ТОЛЬКО если его не ждёт какой-нибудь канал (устройство на exit vpn)
          if lane_rows | awk '$4=="vpn"{f=1} END{exit !f}'; then
            echo "  ${D}туннель оставляю: он назначен устройствам (gate client list)${R}"
            exit_apply >/dev/null || { echo "  ${RED}✗ конфиг выхода не применился${R}"; return 1; }
          else
            vpn_off
          fi ;;
        socks)
          exit_apply >/dev/null || { echo "  ${RED}✗ конфиг выхода не применился${R}"; return 1; } ;;
        *)
          exit_apply >/dev/null || { echo "  ${RED}✗ конфиг выхода не применился${R}"; return 1; } ;;
      esac
      render_pi_apply >/dev/null 2>&1
      echo "Глобальный выход: ${GRN}прямой C2${R}"
      ;;
    ovpn|pptp)
      [ "${2:-on}" = off ] && { cmd_global off; return $?; }
      exit_has "$sub" || { echo "Нет конфига $sub. Сначала: ${YEL}gate $sub set …${R}"; return 1; }
      vpn_on "$sub" || return 1
      ;;
    socks)
      [ "${2:-on}" = off ] && { cmd_global off; return $?; }
      local prof="${3:-${2:-}}"; [ "$prof" = on ] && prof=""
      if [ -n "$prof" ]; then
        sudo test -f "$PROFILE_DIR/socks/$prof.conf" || {
          echo "  ${RED}✗ нет профиля носка «$prof»${R} (${YEL}gate profile list socks${R})"; return 1; }
      else
        [ -f "$SOCKS_CONF" ] || { echo "Нет носка. ${YEL}gate socks set <ip> <port> …${R} или укажи профиль"; return 1; }
      fi
      cmd_socks on "$prof" || return 1
      ;;
    *) echo "gate global {status | off | ovpn on|off | pptp on|off | socks on [профиль]}" ;;
  esac
}

cmd_lanes(){
  case "${1:-status}" in
    init)
      [ -f "$CHAIN_JSON" ] || { echo "нет $CHAIN_JSON — сначала gate setup"; return 1; }
      local n="${2:-4}"
      [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le 16 ] || { echo "gate lanes init [1..16]"; return 1; }
      echo "→ Создаю пул из $n каналов (идентичности на каждом хопе)…"
      local r; r="$(sudo python3 - "$CHAIN_JSON" "$n" <<'PYEOF'
import json, sys, uuid
p, n = sys.argv[1], int(sys.argv[2])
c = json.load(open(p))
added = 0
for h in c["hops"]:
    lu = h.get("lane_uuids") or {}
    # старые поля полос (uuid_b/uuid_c) переносим в каналы, чтобы не плодить идентичности
    for old in ("uuid_b", "uuid_c"):
        if h.get(old):
            free = [str(i) for i in range(1, n + 1) if str(i) not in lu]
            if free:
                lu[free[0]] = h.pop(old); added += 1
            else:
                h.pop(old)
    for i in range(1, n + 1):
        if not lu.get(str(i)):
            lu[str(i)] = str(uuid.uuid4()); added += 1
    h["lane_uuids"] = {k: v for k, v in lu.items() if int(k) <= n} if all(
        k.isdigit() for k in lu) else lu
json.dump(c, open(p, "w"), indent=2)
print("каналов на хоп: %d (новых идентичностей: %d)" % (n, added))
PYEOF
)" || { echo "  ✗ не удалось обновить chain.json"; return 1; }
      echo "  $r"
      echo "→ Переливаю конфиги на хопы и малину (xray -test на каждом)…"
      /usr/local/bin/gate-setup redeploy || { echo "  ${RED}✗ передеплой не прошёл${R}"; return 1; }
      # redeploy рендерит конфиг выхода С НУЛЯ (chain-render не знает про выходы) — возвращаем
      # актуальный режим, иначе глобальный выход/каналы тихо съехали бы на прямой C2.
      echo "→ Возвращаю режим выхода…"
      exit_apply >/dev/null && echo "  ✓ режим выхода восстановлен" \
        || echo "  ${YEL}⚠ не удалось — ${R}gate global status"
      echo
      echo "Каналы созданы. Дальше: ${YEL}gate client <ip|mac|имя> exit vpn|socks:<профиль>${R}"
      ;;
    apply)
      lanes_enabled || { echo "  ${RED}✗ каналы не созданы${R} — ${YEL}gate lanes init${R}"; return 1; }
      echo "→ Применяю раскладку каналов на малине…"
      dnscrypt_listen_ensure; lanes_self_route; lanes_dhcp_write
      sudo systemctl restart dnsmasq 2>/dev/null
      render_pi_apply || return 1
      tproxy_active && sudo bash "$TPROXY_UP" >/dev/null 2>&1
      echo "→ Применяю конфиг выхода на C2…"
      exit_apply >/dev/null || { echo "  ${RED}✗ конфиг выхода не применился${R}"; return 1; }
      lane_list ;;
    status)
      if lanes_enabled; then
        echo "Каналы: ${GRN}созданы${R} — пул $(lanes_pool), занято $(lane_rows | awk '{print $3}' | sort -u | grep -c . 2>/dev/null || true); назначено устройств: $(lane_any_count)"
        echo "Глобальный выход: ${GRN}$(global_label)${R}"
      else
        echo "Каналы: ${RED}не созданы${R} — включить: ${YEL}gate lanes init${R}"
      fi ;;
    *) echo "gate lanes {init [N]|status|apply}" ;;
  esac
}

# ─── Команда: tunnel (TPROXY data plane) ──────────────────────────────
# Поднимает/опускает перехват клиентского трафика в xray TPROXY.
# WG больше нет: клиент → TPROXY :12345 → reality-s1 → C1(реле) → C2.
# Реальную работу делают gate-tproxy-up.sh / gate-tproxy-down.sh.

cmd_tunnel(){
  case "${1:-status}" in
    up)
      if ! svc_active "$XRAY_SVC"; then
        echo "xray не запущен — поднимаю…"; sudo systemctl start "$XRAY_SVC"; sleep 1
      fi
      sudo bash "$TPROXY_UP"
      echo "Проверка выхода цепочки…"; sleep 1
      local ip; ip=$(tunnel_exit_ip 10)
      printf "  Exit IP: %s%s%s\n" "$YEL" "${ip:-не определён (проверь xray/C1)}" "$R"
      ;;

    down)
      echo "→ Опускаю tproxy…"
      sudo bash "$TPROXY_DOWN"
      echo "Перехват снят. Клиентский трафик заблокирован (fail-closed)."
      ;;

    restart) cmd_tunnel down; sleep 1; cmd_tunnel up ;;

    status|*)
      printf "\n%s┌─ Туннель (TPROXY) ────────────────────────────%s\n" "$CYA" "$R"
      printf "%s│%s tproxy: " "$CYA" "$R"
      if tproxy_active; then printf "%s  перехват → :%s\n" "$(ok)" "$TPROXY_PORT"
      else printf "%s опущен (fail-closed)\n" "$(bad)"; fi
      printf "%s│%s xray:   %s\n" "$CYA" "$R" "$(svc_active "$XRAY_SVC" && ok || bad)"
      printf "%s│%s rules:  %s/2 (fwmark 1→tproxy, 255→WAN)\n" "$CYA" "$R" \
        "$(ip -4 rule show | grep -cE 'fwmark 0x(1|ff) ')"
      printf "%s│%s killsw: %s\n" "$CYA" "$R" \
        "$(sudo iptables -S FORWARD 2>/dev/null | grep -qc "$AP_SUBNET -j DROP" && echo ok || echo нет)"
      printf "%s│%s exit:   %s%s%s\n" "$CYA" "$R" "$YEL" "$(tunnel_exit_ip 6)" "$R"
      printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"
      ;;
  esac
}

# Защита DNS от утечки домашнего IP на буте (идемпотентно; зовётся из doctor при fix):
#   • netprobe dnscrypt → loopback: иначе стартовая проба 9.9.9.9:53 уходит ДО подъёма
#     tproxy и светит домашний IP Quad9 каждую загрузку;
#   • ordering-drop-in: dnscrypt стартует ПОСЛЕ gate-tunnel, чтобы обновление списка
#     резолверов (HTTPS к download.dnscrypt.info, refresh 72ч) шло уже через цепочку.
harden_dns(){
  local changed=0 toml="$DNSCRYPT_TOML"
  if [ -f "$toml" ] && ! grep -qE "^[[:space:]]*netprobe_address[[:space:]]*=[[:space:]]*'127\.0\.0\.1" "$toml"; then
    # netprobe_address — глобальный ключ, обязан быть ДО любой [секции]. Нет строки → вставляем
    # в НАЧАЛО (дописать в конец нельзя: попадёт внутрь [sources] → dnscrypt упадёт FATAL).
    if grep -qE "^#? *netprobe_address" "$toml"; then
      sudo sed -i "s|^#\? *netprobe_address =.*|netprobe_address = '127.0.0.1:53'|" "$toml"
    else
      sudo sed -i "1i netprobe_address = '127.0.0.1:53'" "$toml"
    fi
    changed=1
  fi
  local dropin=/etc/systemd/system/dnscrypt-proxy.service.d/10-gate-after-tunnel.conf
  if [ ! -f "$dropin" ]; then
    sudo install -d /etc/systemd/system/dnscrypt-proxy.service.d
    printf '[Unit]\nAfter=gate-tunnel.service\n' | sudo tee "$dropin" >/dev/null
    sudo systemctl daemon-reload
    changed=1
  fi
  [ "$changed" = 1 ] && sudo systemctl restart dnscrypt-proxy >/dev/null 2>&1
  return 0
}

# ─── Команда: doctor ─ проверка+починка (после apt upgrade / ребута) ──
# `gate doctor`       — проверить И переприменить (службы + tproxy идемпотентно)
# `gate doctor check` — только проверить, ничего не трогать
cmd_doctor(){
  local fix=1; [ "${1:-}" = check ] && fix=0
  printf "\n%s┌─ gate doctor ─────────────────────────────────%s\n" "$CYA" "$R"
  # 1) бэкенд iptables — критично для tproxy (смена nft↔legacy ломает перехват)
  local be; be="$(sudo iptables --version 2>/dev/null | grep -oE 'nf_tables|legacy' || echo '?')"
  printf "%s│%s iptables: %s %s\n" "$CYA" "$R" "$be" "$([ "$be" = nf_tables ] && ok || bad)"
  # 2) интерфейсы
  printf "%s│%s AP %s:  %s\n" "$CYA" "$R" "$AP_IFACE" "$([ "$(cat /sys/class/net/$AP_IFACE/operstate 2>/dev/null)" = up ] && ok || bad)"
  printf "%s│%s WAN route: %s\n" "$CYA" "$R" "$([ -n "$(default_dev)" ] && ok || bad)"
  # 3) службы — при fix поднимаем упавшие
  local s
  for s in dnscrypt-proxy hostapd dnsmasq "$XRAY_SVC"; do
    if svc_active "$s"; then printf "%s│%s svc %-14s %s\n" "$CYA" "$R" "$s:" "$(ok)"
    else
      printf "%s│%s svc %-14s %s" "$CYA" "$R" "$s:" "$(bad)"
      [ "$fix" = 1 ] && { sudo systemctl start "$s" >/dev/null 2>&1 && printf " → поднял" || printf " → не поднялся"; }
      printf "\n"
    fi
  done
  # 4) tproxy — при fix переприменяем (гарантирует правила под текущий backend/интерфейсы)
  if [ "$fix" = 1 ] && svc_active "$XRAY_SVC"; then
    printf "%s│%s tproxy: переприменяю…\n" "$CYA" "$R"; sudo bash "$TPROXY_UP" >/dev/null 2>&1 || true
  fi
  printf "%s│%s tproxy: %s\n" "$CYA" "$R" "$(tproxy_active && ok || bad)"
  # 5) DNS-утечка на буте: netprobe→lo + dnscrypt после туннеля (при fix — чиним идемпотентно)
  [ "$fix" = 1 ] && harden_dns
  local np; np="$(grep -m1 -E "^[[:space:]]*netprobe_address" "$DNSCRYPT_TOML" 2>/dev/null | sed "s/.*= *//")"
  printf "%s│%s DNS-утечка: netprobe %s %s\n" "$CYA" "$R" \
    "$(printf '%s' "$np" | grep -q 127.0.0.1 && echo 'на lo' || echo '9.9.9.9 (деф!)')" \
    "$(printf '%s' "$np" | grep -q 127.0.0.1 && ok || bad)"
  # 6) выход в интернет
  printf "%s│%s наружу: %s\n" "$CYA" "$R" "$(curl -s --max-time 6 -o /dev/null "$EXIT_CHECK_URL" 2>/dev/null && ok || bad)"
  printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"
  if [ "$fix" = 1 ]; then echo "Если «наружу» — down: gate tunnel restart, при апдейте ядра — reboot."; fi
  return 0
}

# ─── Команды: freeze / unfreeze ─ пин версий пакетов (apt-mark hold) ──
# Аппаратный принцип: обновил один раз → проверил (gate doctor) → заморозил.
# Дальше apt upgrade ничего не двигает, пока сам не разморозишь.
RISK_PKGS="raspberrypi-kernel raspberrypi-bootloader linux-image-rpi-v8 linux-image-rpi-2712 firmware-brcm80211 raspi-firmware iptables hostapd dnsmasq dnscrypt-proxy wpasupplicant network-manager"
cmd_freeze(){
  case "${1:-all}" in
    all)
      local n; n=$(dpkg-query -Wf '${Package}\n' 2>/dev/null | wc -l)
      echo "→ Замораживаю ВСЕ пакеты ($n) на текущих версиях…"
      dpkg-query -Wf '${Package}\n' 2>/dev/null | xargs -r sudo apt-mark hold >/dev/null
      echo "  ✓ заморожено. apt upgrade теперь ничего не поднимет. Разморозить: gate unfreeze"
      ;;
    risk)
      echo "→ Замораживаю риск-пакеты (ядро/firmware/сеть/iptables)…"
      local p held=0
      for p in $RISK_PKGS; do dpkg-query -W "$p" >/dev/null 2>&1 && sudo apt-mark hold "$p" >/dev/null 2>&1 && held=$((held+1)); done
      echo "  ✓ заморожено риск-пакетов: $held (разморозить: gate unfreeze)"
      ;;
    status)
      local h; h="$(apt-mark showhold 2>/dev/null)"
      [ -n "$h" ] && { echo "Заморожено ($(printf '%s\n' "$h" | wc -l)):"; printf '%s\n' "$h" | sed 's/^/  /'; } || echo "Ничего не заморожено."
      ;;
    *) echo "gate freeze {all|risk|status}  •  gate unfreeze" ;;
  esac
}
cmd_unfreeze(){
  local h; h="$(apt-mark showhold 2>/dev/null)"
  [ -z "$h" ] && { echo "Заморозок нет."; return 0; }
  echo "→ Размораживаю $(printf '%s\n' "$h" | wc -l) пакетов…"
  printf '%s\n' "$h" | xargs -r sudo apt-mark unhold >/dev/null
  echo "  ✓ разморожено."
}

# ─── Команда: socks (финальный хоп через покупной SOCKS5) ─────────────
# Носок надевается на С2 (дозвон от С2, прокси видит IP С2, не тебя).
# Управление с малины через SSH-цепочку малина→С1→С2 (С2 видит только С1).
# Killswitch fail-closed: носок включён и упал → клиентский трафик встаёт,
# IP С2 НЕ вытекает. UDP режется (нет утечек мимо носка).

# выполнить команду на ВЫХОДНОМ хопе через SSH-цепочку (Pi→C1→…→exit).
# Ключи-на-хопах: малина→C1 ключом малины, C1→C2 ключом C1, и т.д. Вложенную
# команду (с экранированием на каждом уровне) строит рендерер по chain.json.
s2_exec(){
  local full
  full="$(printf '%s' "$1" | python3 "$RENDER" exit-cmd "$CHAIN_JSON" 2>/dev/null)" || return 1
  [ -n "$full" ] || return 1
  bash -c "$full"
}

# Проба возможностей носка С ТОЧКИ ВЫХОДА (C2): TCP+auth, remote-DNS (CONNECT по
# домену), UDP (UDP ASSOCIATE + реальный DNS-запрос через релей — функционально,
# т.к. носки врут на handshake). Нужны SOCKS_IP/PORT/USER/PASS в окружении.
# Печатает: TCP=ok|fail / RDNS=ok|fail / UDP=ok|fail / EXIT_IP=...
socks_probe(){
  local py
  py=$(cat <<PYEOF
import socket,struct,os
IP="$SOCKS_IP";PORT=int("$SOCKS_PORT");USER="$SOCKS_USER";PW="$SOCKS_PASS"
def greet(s):
    if USER:
        s.sendall(b"\x05\x01\x02");r=s.recv(2)
        if len(r)<2 or r[1]!=2: return False
        u=USER.encode();p=PW.encode()
        s.sendall(b"\x01"+bytes([len(u)])+u+bytes([len(p)])+p);r=s.recv(2)
        return len(r)>=2 and r[1]==0
    s.sendall(b"\x05\x01\x00");r=s.recv(2);return len(r)>=2 and r[1]==0
def conn(s,atyp,addr,port):
    s.sendall(b"\x05\x01\x00"+bytes([atyp])+addr+struct.pack(">H",port));r=s.recv(4)
    if len(r)<4: return None
    rep=r[1];at=r[3]
    if at==1: s.recv(4)
    elif at==3: s.recv(s.recv(1)[0])
    elif at==4: s.recv(16)
    s.recv(2);return rep
def dnsq(name):
    q=os.urandom(2)+b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00"
    for part in name.split("."): q+=bytes([len(part)])+part.encode()
    return q+b"\x00\x00\x01\x00\x01"
def tcp_rdns():
    try:
        s=socket.create_connection((IP,PORT),timeout=10)
        if not greet(s): s.close();return("fail","fail","")
        d=b"api.ipify.org"
        if conn(s,3,bytes([len(d)])+d,80)==0:
            s.sendall(b"GET / HTTP/1.0\r\nHost: api.ipify.org\r\nConnection: close\r\n\r\n")
            s.settimeout(10);buf=b""
            while True:
                try: c=s.recv(4096)
                except: break
                if not c: break
                buf+=c
            s.close()
            body=buf.split(b"\r\n\r\n",1)[-1].strip().decode("utf-8","ignore")
            return("ok","ok",body.splitlines()[-1].strip() if body else "")
        s.close()
    except: pass
    try:
        s=socket.create_connection((IP,PORT),timeout=10)
        if not greet(s): s.close();return("fail","fail","")
        rep=conn(s,1,socket.inet_aton("1.1.1.1"),80);s.close()
        return("ok" if rep==0 else "fail","fail","")
    except: return("fail","fail","")
def udp():
    try:
        s=socket.create_connection((IP,PORT),timeout=10)
        if not greet(s): s.close();return"fail"
        s.sendall(b"\x05\x03\x00\x01\x00\x00\x00\x00\x00\x00");r=s.recv(4)
        if len(r)<4 or r[1]!=0: s.close();return"fail"
        at=r[3]
        if at==1: ra=socket.inet_ntoa(s.recv(4))
        elif at==3: ra=s.recv(s.recv(1)[0]).decode()
        elif at==4: ra=socket.inet_ntop(socket.AF_INET6,s.recv(16))
        else: s.close();return"fail"
        rp=struct.unpack(">H",s.recv(2))[0]
        if ra in ("0.0.0.0",""): ra=IP
        q=dnsq("example.com")
        hdr=b"\x00\x00\x00\x01"+socket.inet_aton("8.8.8.8")+struct.pack(">H",53)
        u=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);u.settimeout(6)
        u.sendto(hdr+q,(ra,rp));data,_=u.recvfrom(2048);u.close();s.close()
        dns=data[10:]
        return "ok" if (len(dns)>=12 and dns[:2]==q[:2]) else "fail"
    except: return"fail"
t,rd,ip=tcp_rdns();ud=udp()
print("TCP="+t);print("RDNS="+rd);print("UDP="+ud);print("EXIT_IP="+ip)
PYEOF
)
  s2_exec "python3 - <<'XPY'
$py
XPY"
}

# Сохранить возможности носка в /etc/gate/socks.caps (читает chain-render).
socks_caps_set(){
  local tcp rdns udp
  tcp=$(printf '%s\n' "$1" | sed -n 's/^TCP=//p'); rdns=$(printf '%s\n' "$1" | sed -n 's/^RDNS=//p')
  udp=$(printf '%s\n' "$1" | sed -n 's/^UDP=//p')
  sudo bash -c "mkdir -p /etc/gate; cat > $SOCKS_CAPS <<EOF
TCP=${tcp:-fail}
RDNS=${rdns:-fail}
UDP=${udp:-fail}
EOF
chown pi:pi $SOCKS_CAPS"
}

cmd_socks(){
  case "${1:-status}" in
    test)
      if [ -n "${2:-}" ]; then
        SOCKS_IP="$2"; SOCKS_PORT="${3:-}"; SOCKS_USER="${4:-}"; SOCKS_PASS="${5:-}"
      else
        [ -f "$SOCKS_CONF" ] || { echo "Нет носка. Укажи: gate socks test <ip> <port> [user] [pass]"; exit 1; }
        eval "$(sudo cat "$SOCKS_CONF" 2>/dev/null)"
      fi
      echo "→ Проба носка $SOCKS_IP:$SOCKS_PORT с C2 (TCP / remote-DNS / UDP)…"
      local caps; caps=$(socks_probe | tr -d '\r')
      local tcp rdns udp eip
      tcp=$(printf '%s\n' "$caps" | sed -n 's/^TCP=//p'); rdns=$(printf '%s\n' "$caps" | sed -n 's/^RDNS=//p')
      udp=$(printf '%s\n' "$caps" | sed -n 's/^UDP=//p');  eip=$(printf '%s\n' "$caps" | sed -n 's/^EXIT_IP=//p')
      if [ "$tcp" != "ok" ]; then
        printf "  %sНосок НЕ отвечает по TCP%s (мёртв / неверные данные)\n" "$RED" "$R"; exit 1
      fi
      mk(){ [ "$1" = ok ] && printf "%sok%s" "$GRN" "$R" || printf "%sнет%s" "$RED" "$R"; }
      printf "  TCP+auth:   %s   выходной IP: %s%s%s\n" "$(mk "$tcp")" "$YEL" "${eip:-?}" "$R"
      printf "  remote-DNS: %s   (носок сам резолвит домены → его резолвер виден)\n" "$(mk "$rdns")"
      printf "  UDP:        %s   (UDP ASSOCIATE → QUIC/UDP-приложения)\n" "$(mk "$udp")"
      if [ -n "$eip" ]; then
        local geo; geo=$(s2_exec "curl -s --max-time 10 http://ip-api.com/line/$eip?fields=country,regionName,city,isp 2>/dev/null")
        [ -n "$geo" ] && printf "  гео:        %s\n" "$(echo "$geo" | tr '\n' ' ')"
      fi
      ;;
    set)
      # gate socks set <ip> <port> [user] [pass]
      local ip="${2:-}" port="${3:-}" user="${4:-}" pass="${5:-}"
      if [ -z "$ip" ] || [ -z "$port" ]; then
        echo "Использование: gate socks set <ip> <port> [user] [pass]"; exit 1
      fi
      sudo mkdir -p /etc/gate
      sudo bash -c "umask 077; cat > $SOCKS_CONF <<EOF
SOCKS_IP=$ip
SOCKS_PORT=$port
SOCKS_USER=$user
SOCKS_PASS=$pass
EOF"
      sudo rm -f "$SOCKS_CAPS"   # старые возможности неактуальны для нового носка
      echo "Носок сохранён: $ip:$port${user:+ (auth: $user)}"
      echo "Проверить: gate socks test   •   включить: gate global socks on"
      ;;

    promote)
      # gate socks promote <имя> — сохранить ТЕКУЩИЙ (безымянный) носок как профиль.
      # Нужно, чтобы его можно было вешать на устройство (gate client <dev> exit socks:<имя>)
      # и видеть в веб-панели: там перечислены именно профили. Креды не переспрашиваем —
      # просто копируем файл, поэтому пароль никуда не «всплывает».
      local n="${2:-}"
      prof_name_ok "$n" || { echo "gate socks promote <имя>   ${D}(имя: A-Za-z0-9._-)${R}"; exit 1; }
      sudo test -f "$SOCKS_CONF" || { echo "Нет текущего носка — сначала: ${YEL}gate socks set <ip> <port> [user] [pass]${R}"; exit 1; }
      sudo mkdir -p "$PROFILE_DIR/socks"
      sudo install -m600 "$SOCKS_CONF" "$PROFILE_DIR/socks/$n.conf"
      [ -f "$SOCKS_CAPS" ] && sudo install -m600 "$SOCKS_CAPS" "$PROFILE_DIR/socks/$n.caps"
      echo "Текущий носок сохранён как профиль ${B}$n${R}"
      echo "  ${D}повесить на устройство:${R} gate client <ip|mac|имя> exit socks:$n"
      echo "  ${D}сделать основным:${R}      gate global socks on $n"
      ;;

    on)
      # gate socks on [профиль] — сделать носок ГЛОБАЛЬНЫМ выходом (зовётся из gate global socks on)
      local prof="${2:-}"
      if [ -n "$prof" ]; then
        sudo test -f "$PROFILE_DIR/socks/$prof.conf" || { echo "Нет профиля носка «$prof» (gate profile list socks)"; exit 1; }
        eval "$(sudo cat "$PROFILE_DIR/socks/$prof.conf" 2>/dev/null)"
      else
        [ -f "$SOCKS_CONF" ] || { echo "Сначала задай носок: gate socks set ... (или укажи профиль)"; exit 1; }
        eval "$(sudo cat "$SOCKS_CONF" 2>/dev/null)"
      fi
      echo "→ Пробую носок $SOCKS_IP:$SOCKS_PORT (TCP / remote-DNS / UDP)…"
      local caps; caps=$(socks_probe | tr -d '\r')
      local tcp rdns udp
      tcp=$(printf '%s\n' "$caps" | sed -n 's/^TCP=//p'); rdns=$(printf '%s\n' "$caps" | sed -n 's/^RDNS=//p')
      udp=$(printf '%s\n' "$caps" | sed -n 's/^UDP=//p')
      if [ "$tcp" != "ok" ]; then
        echo "  ${RED}✗ носок не отвечает по TCP — не включаю (fail-closed)${R}"; exit 1
      fi
      printf "  возможности: TCP=%s  remote-DNS=%s  UDP=%s\n" "$tcp" "$rdns" "$udp"
      # возможности пишем рядом с профилем — exit_apply решает по ним, пускать ли UDP
      if [ -n "$prof" ]; then
        printf '%s\n' "$caps" | sudo tee "$PROFILE_DIR/socks/$prof.caps" >/dev/null
      else
        socks_caps_set "$caps"
      fi
      [ "$udp" = ok ] && echo "  → UDP через носок ВКЛ (QUIC/UDP оживают)" \
                      || echo "  → UDP режется (носок не умеет UDP)"
      [ "$rdns" = ok ] && echo "  → DNS резолвит носок (его резолвер)" || echo "  → DNS резолвит малина (Cloudflare), несём IP"
      echo "→ Делаю носок глобальным выходом на С2…"
      # Флаги ставим ДО сборки: exit_apply читает состояние из файлов. Конфиг выхода собирает
      # ЕДИНЫЙ exit_apply — он сохранит каналы и, если нужен, туннель.
      echo on | sudo tee "$SOCKS_STATE" >/dev/null
      sudo bash -c "printf 'GLOBAL=socks\nGLOBAL_SOCKS=%s\n' '$prof' > $GLOBAL_EXIT"
      if ! exit_apply; then
        echo off | sudo tee "$SOCKS_STATE" >/dev/null
        sudo bash -c "printf 'GLOBAL=c2\nGLOBAL_SOCKS=\n' > $GLOBAL_EXIT"
        echo "  ${RED}✗ конфиг выхода не применился — носок НЕ включён${R}"; exit 1
      fi
      echo "→ Подстраиваю DNS/QUIC-политику малины под носок…"
      render_pi_apply
      echo "Проверка выхода…"; sleep 2
      cmd_socks status
      ;;

    off)
      echo "→ Выключаю носок, возврат на прямой выход С2 (через цепочку)…"
      # Флаг снимаем ДО сборки; exit_apply уберёт socks-out и вернёт direct, СОХРАНИВ активный
      # VPN и полосы (раньше здесь свой инлайн-питон затирал конфиг целиком, снося vpn-out).
      echo off | sudo tee "$SOCKS_STATE" >/dev/null
      case "$(global_get)" in socks) sudo bash -c "printf 'GLOBAL=c2\nGLOBAL_SOCKS=\n' > $GLOBAL_EXIT" ;; esac
      exit_apply >/dev/null || echo "  ${YEL}⚠ конфиг выхода не применился — проверь gate exit${R}"
      echo "→ Возвращаю DNS-политику малины (резолв через Cloudflare, QUIC режется)…"
      render_pi_apply
      echo "Носок снят. Выход напрямую с С2."; sleep 2
      cmd_socks status
      ;;

    status)
      printf "\n%s┌─ Носок (SOCKS5 финальный хоп) ────────────────%s\n" "$CYA" "$R"
      if [ -f "$SOCKS_CONF" ]; then
        eval "$(sudo cat "$SOCKS_CONF" 2>/dev/null)"
        printf "%s│%s сохранён: %s:%s%s\n" "$CYA" "$R" "$SOCKS_IP" "$SOCKS_PORT" \
          "${SOCKS_USER:+ (auth)}"
      else
        printf "%s│%s носок не задан\n" "$CYA" "$R"
      fi
      if [ -f "$SOCKS_CAPS" ]; then
        cap(){ grep -E "^$1=" "$SOCKS_CAPS" 2>/dev/null | cut -d= -f2; }
        printf "%s│%s умеет:   TCP=%s remote-DNS=%s UDP=%s\n" "$CYA" "$R" \
          "$(cap TCP)" "$(cap RDNS)" "$(cap UDP)"
      fi
      # режим определяем по наличию socks-out в конфиге С2
      local mode; mode=$(s2_exec "grep -c socks-out $EXIT_XRAY_CONF 2>/dev/null" 2>/dev/null)
      if [ "${mode:-0}" -gt 0 ] 2>/dev/null; then
        printf "%s│%s режим:   %sВКЛЮЧЁН%s (трафик через носок)\n" "$CYA" "$R" "$GRN" "$R"
      else
        printf "%s│%s режим:   %sвыключен%s (прямой выход С2)\n" "$CYA" "$R" "$YEL" "$R"
      fi
      # выходной IP цепочки (через socks-test → C1 → C2 → носок)
      local ip; ip=$(tunnel_exit_ip 8)
      printf "%s│%s выход:   %s%s%s\n" "$CYA" "$R" "$YEL" "${ip:-—}" "$R"
      printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"
      ;;

    *)
      echo "gate socks {set <ip> <port> [user] [pass]|promote <имя>|test|status}"
      echo "  ${D}включить глобально: gate global socks on [профиль]${R}"
      echo "  ${D}устройству персонально: gate client <dev> exit socks:<профиль>${R}"
      ;;
  esac
}

# ─── Команда: dns — проверка DNS-утечки (browserleaks-стиль) ──────────
# Резолвит уникальные имена через ВЫХОД цепочки (edns.ip-api.com отдаёт IP/гео
# резолвера, что реально queried) — несколько проб, т.к. у носка пул резолверов.
# Критично: DNS должен идти СО СТОРОНЫ ВЫХОДА (носок), НИКОГДА с C2. Утечку ловим
# по совпадению страны резолвера со страной выходного хопа C2.
# Запасной DNS (Cloudflare+Google) для VPN-режима, если туннель свой DNS не отдал.
# По правилу «не добавлять свои дефолты молча» — по умолчанию off, включается только явно.
dns_fallback_set(){
  case "${1:-}" in
    on|off)
      echo "$1" | sudo tee "$DNS_FALLBACK_STATE" >/dev/null
      echo "Запасной DNS: $1  ($DNS_FALLBACK_SERVERS — только если туннель свой DNS не дал)"
      [ "$1" = on ] && [ "$(cat "$VPN_STATE" 2>/dev/null)" = on ] && \
        echo "  ${D}применится при следующем gate <type> on (сейчас VPN уже поднят)${R}" ;;
    ""|status)
      echo "Запасной DNS: $(cat "$DNS_FALLBACK_STATE" 2>/dev/null || echo off)  ($DNS_FALLBACK_SERVERS)" ;;
    *) echo "gate dns fallback {on|off|status}" ;;
  esac
}
# Резолвер САМОЙ малины для ПРЯМОГО выхода (нет VPN/носка) — переключатель Cloudflare/Google/Quad9.
# Влияет на прямой режим и Force-DNS; в VPN DNS идёт из туннеля, в socks-RDNS резолвит носок.
dns_resolver_set(){
  local p="${1:-}" names
  case "$p" in
    cloudflare|cf) p=cloudflare; names="'cloudflare'" ;;
    quad9|q9|q)    p=quad9;      names="'quad9-dnscrypt-ip4-nofilter-pri', 'quad9-doh-ip4-port443-nofilter-pri'" ;;
    ""|status)
      printf "Резолвер малины (прямой выход): %s%s%s\n" "$GRN" "$(grep -m1 '^server_names' "$DNSCRYPT_TOML" 2>/dev/null | sed 's/.*= //')" "$R"
      echo "  ${D}переключить: gate dns resolver {cloudflare|quad9}${R}"; return ;;
    *) echo "gate dns resolver {cloudflare|quad9}  (google не отвечает с РФ-IP)"; return ;;
  esac
  [ -f "$DNSCRYPT_TOML" ] || { echo "  ✗ нет $DNSCRYPT_TOML на малине"; return 1; }
  sudo cp -a "$DNSCRYPT_TOML" "$DNSCRYPT_TOML.bak-$(date +%Y%m%d-%H%M%S)"
  sudo sed -i "s/^server_names = .*/server_names = [$names]/" "$DNSCRYPT_TOML"
  sudo systemctl restart dnscrypt-proxy; sleep 3
  if systemctl is-active --quiet dnscrypt-proxy; then
    echo "Резолвер малины (прямой выход) → ${GRN}$p${R}  [$names]"
    echo "  ${D}действует в режиме «прямой C2»; проверить: gate dns${R}"
  else
    echo "  ${RED}✗ dnscrypt-proxy не поднялся${R} — бэкап рядом: $DNSCRYPT_TOML.bak-*"
  fi
}
# Резолвер конкретной полосы: gate dns lane [<выход> [<ip[,ip]>]]
# Подбирать замером: у anycast-резолверов «страна» зависит от того, откуда к ним пришли,
# поэтому один и тот же 9.9.9.9 с разных выходов даёт разные страны.
dns_lane_set(){
  local tgt="${1:-}" val="${2:-}"
  if [ -z "$tgt" ]; then
    printf "\nРезолверы полос:\n"
    printf "  %-16s %s\n" "vpn" "$(lane_dns_for vpn)  ${D}(пушит VPN-сервер)${R}"
    printf "  %-16s %s\n" "c2" "$(lane_dns_for c2)"
    local t
    for t in $(lane_rows | awk '$4 ~ /^socks:/ {print $4}' | sort -u); do
      printf "  %-16s %s\n" "$t" "$(lane_dns_for "$t")"
    done
    printf "  ${D}задать: gate dns lane <c2|socks:профиль|vpn> <ip[,ip]>${R}\n"
    printf "  ${D}проверить, какой страны резолвер: gate dns${R}\n\n"
    return 0
  fi
  case "$tgt" in
    c2|vpn|socks:*) ;;
    *) echo "Выход: ${GRN}c2${R} · ${YEL}vpn${R} · ${YEL}socks:<профиль>${R}"; return 1 ;;
  esac
  [ -n "$val" ] || { echo "gate dns lane $tgt <ip[,ip]>"; return 1; }
  local ip
  for ip in ${val//,/ }; do
    printf '%s' "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || { echo "  ${RED}✗ не IP: $ip${R}"; return 1; }
  done
  sudo touch "$LANE_DNS_CONF"
  sudo sed -i "\|^$tgt[[:space:]]|d" "$LANE_DNS_CONF"
  echo "$tgt $val" | sudo tee -a "$LANE_DNS_CONF" >/dev/null
  echo "Резолвер полосы ${YEL}$tgt${R} → ${GRN}$val${R}"
  lanes_dhcp_write; sudo systemctl restart dnsmasq 2>/dev/null
  tproxy_active && sudo bash "$TPROXY_UP" >/dev/null 2>&1
  echo "  ${D}устройствам нужно переподключиться к Wi-Fi, чтобы забрать новый DNS${R}"
}

cmd_dns(){
  case "${1:-}" in
    fallback) shift; dns_fallback_set "$@"; return ;;
    resolver) shift; dns_resolver_set "$@"; return ;;
    lane)     shift; dns_lane_set "$@"; return ;;
  esac
  local n="${1:-4}"; [[ "$n" =~ ^[0-9]+$ ]] || n=4
  local jget='import sys,json
try: d=json.load(sys.stdin)
except: d={}'
  printf "\n%s┌─ DNS-утечка (что видит мир) ───────────────────%s\n" "$CYA" "$R"
  # выход цепочки + гео (socks-test → C1 → C2 → выход)
  local ej eip ecountry eisp
  ej=$(curl -s --max-time 12 --socks5-hostname "$SOCKS_TEST" "http://ip-api.com/json?fields=query,country,isp" 2>/dev/null)
  eip=$(printf '%s' "$ej"      | python3 -c "$jget
print(d.get('query',''))" 2>/dev/null)
  ecountry=$(printf '%s' "$ej" | python3 -c "$jget
print(d.get('country',''))" 2>/dev/null)
  eisp=$(printf '%s' "$ej"     | python3 -c "$jget
print(d.get('isp',''))" 2>/dev/null)
  if [ -z "$eip" ]; then
    printf "%s│%s %sвыход не отвечает — цепочка/выход не поднят%s\n" "$CYA" "$R" "$RED" "$R"
    printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"; return 1
  fi
  printf "%s│%s выход:  %s%s%s  %s%s · %s%s\n" "$CYA" "$R" "$YEL" "$eip" "$R" "$D" "${ecountry:-?}" "${eisp:-?}" "$R"
  # C2 (выходной хоп) — эталон «как выглядела бы утечка»
  local c2h c2c
  c2h=$(exit_host)
  c2c=$(curl -s --max-time 8 "http://ip-api.com/line/$c2h?fields=country" 2>/dev/null | tr -d '\r\n')
  [ -n "$c2c" ] && printf "%s│%s C2:     %s%s · %s — сюда DNS уходить НЕ должен%s\n" "$CYA" "$R" "$D" "$c2h" "$c2c" "$R"
  # резолверы через выход (несколько проб → разные резолверы пула носка)
  printf "%s│%s резолверы DNS (через выход, %d проб):\n" "$CYA" "$R" "$n"
  local seen="" leak=0 got=0 i
  for ((i=0;i<n;i++)); do
    local dj dip dgeo dcountry flag
    dj=$(curl -sL --max-time 12 --socks5-hostname "$SOCKS_TEST" "https://edns.ip-api.com/json" 2>/dev/null)
    dip=$(printf '%s' "$dj"  | python3 -c "$jget
print(d.get('dns',{}).get('ip',''))" 2>/dev/null)
    dgeo=$(printf '%s' "$dj" | python3 -c "$jget
print(d.get('dns',{}).get('geo',''))" 2>/dev/null)
    [ -z "$dip" ] && continue
    case "$seen" in *"|$dip|"*) continue ;; esac
    seen="$seen|$dip|"; got=$((got+1))
    dcountry=${dgeo%% -*}
    if [ -n "$c2c" ] && [ "$dcountry" = "$c2c" ]; then
      flag="${RED}✗ страна C2 — УТЕЧКА${R}"; leak=1
    elif [ -n "$ecountry" ] && [ "$dcountry" = "$ecountry" ]; then
      flag="${GRN}✓ сторона выхода${R}"
    else
      flag="${YEL}⚠ иная страна${R}"
    fi
    printf "%s│%s   %-15s %s%-30s%s %b\n" "$CYA" "$R" "$dip" "$D" "$dgeo" "$R" "$flag"
  done
  [ "$got" = 0 ] && printf "%s│%s   %s— не определилось%s\n" "$CYA" "$R" "$RED" "$R"
  if [ "$leak" = 1 ]; then
    printf "%s│%s вердикт: %s✗ УТЕЧКА DNS С C2%s — DNS обязан идти только через носок\n" "$CYA" "$R" "$RED" "$R"
  elif [ "$got" -gt 0 ]; then
    printf "%s│%s вердикт: %s✓ утечки C2 нет%s (DNS со стороны выхода)\n" "$CYA" "$R" "$GRN" "$R"
  fi
  printf "%s│%s глазами браузера: %sbrowserleaks.com/dns%s\n" "$CYA" "$R" "$D" "$R"
  printf "%s└───────────────────────────────────────────────%s\n\n" "$CYA" "$R"
}

# ─── Команда: vpn ─ второй exit-mode (OpenVPN/PPTP на выходном хопе) ───
# Залить файл на выходной хоп через цепочку (base64 inline, без stdin-форварда).
push_to_exit(){  # $1=локальный файл, $2=путь на выходном хопе
  local b64; b64=$(base64 -w0 "$1" 2>/dev/null) || return 1
  s2_exec "umask 077; printf '%s' '$b64' | base64 -d > '$2' && echo PUSHED" | grep -q PUSHED
}
# Доставить C2-side скрипт gate-vpn на выходной хоп.
# Идемпотентно и БЕЗ лишнего трафика: сверяем sha256 локального gate-vpn с тем, что на C2, и
# перезаливаем ТОЛЬКО если версии отличаются или файла нет. Нужная версия и так доставляется
# при gate setup (deploy_exit_helpers); поэтому gate ovpn on в норме делает лишь лёгкую сверку,
# а не тяжёлый base64-трансфер через цепочку. Самолечение (переустановили C2) сохранено.
ensure_vpn_script(){
  [ -f "$VPN_SCRIPT" ] || { echo "  нет $VPN_SCRIPT на малине"; return 1; }
  local lh rh
  lh="$(sha256sum "$VPN_SCRIPT" 2>/dev/null | awk '{print $1}')"
  rh="$(s2_exec "sha256sum /usr/local/bin/gate-vpn 2>/dev/null | awk '{print \$1}'" 2>/dev/null | tr -d '\r ')"
  [ -n "$lh" ] && [ "$lh" = "$rh" ] && return 0   # на C2 уже актуальная версия → ничего не делаем
  echo "  → обновляю gate-vpn на C2 (версия отличается или отсутствует)…"
  push_to_exit "$VPN_SCRIPT" "/usr/local/bin/gate-vpn" || return 1
  s2_exec "chmod 755 /usr/local/bin/gate-vpn; echo CHMODOK" >/dev/null
}
# Доставить C2-side контроллер gate-osfp + хендлер gate-osfp.py на выходной хоп.
ensure_osfp_script(){
  [ -f "$OSFP_SCRIPT" ] || { echo "  нет $OSFP_SCRIPT на малине"; return 1; }
  [ -f "$OSFP_PY" ]     || { echo "  нет $OSFP_PY на малине"; return 1; }
  push_to_exit "$OSFP_SCRIPT" "/usr/local/bin/gate-osfp"    || return 1
  push_to_exit "$OSFP_PY"     "/usr/local/bin/gate-osfp.py" || return 1
  s2_exec "chmod 755 /usr/local/bin/gate-osfp /usr/local/bin/gate-osfp.py; echo CHMODOK" >/dev/null
}

# ── OS-fingerprint спуф (gate-osfp на выходном хопе) ──────────────────
# Переписывает исходящие SYN из туннеля под выбранную ОС. Работает только с L3-выходом
# (PPTP/OpenVPN); с носком неприменим. Включается/выключается ВРУЧНУЮ, VPN сам не трогает.
cmd_osfp(){
  case "${1:-status}" in
    on)
      local p="${2:-apple}"
      case "$p" in apple|windows|linux) ;; *) echo "gate osfp on {apple|windows|linux}"; exit 1 ;; esac
      local cur; cur=$(active_exit)
      case "$cur" in
        ovpn|pptp) ;;
        *) echo "  ${YEL}⚠ выход сейчас «$(exit_label "$cur")» — спуф работает только с VPN-выходом (PPTP/OpenVPN).${R}"
           echo "    ${D}правило поставлю, но эффект будет лишь когда поднимешь gate ovpn/pptp on.${R}" ;;
      esac
      echo "→ Доставляю gate-osfp на C2 и включаю профиль $p…"
      ensure_osfp_script || { echo "не удалось доставить скрипт"; exit 1; }
      s2_exec "gate-osfp on $p" ;;
    off)
      ensure_osfp_script >/dev/null 2>&1   # самозаживление: дозалить контроллер, если на выходе нет
      echo "→ Выключаю OS-спуф на C2…"
      s2_exec "gate-osfp off" 2>/dev/null || echo "  (контроллер не отвечает — возможно уже выключен)" ;;
    status)
      ensure_osfp_script >/dev/null 2>&1   # самозаживление: если выход свежий/переустановлен — дозальём
      local out; out=$(s2_exec "gate-osfp status 2>/dev/null" 2>/dev/null)
      [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  /' || echo "  выход не отвечает (цепочка/выход не подняты)" ;;
    *) echo "gate osfp {on [apple|windows|linux]|off|status}" ;;
  esac
}

# ── Общая логика exit-режимов (socks / ovpn / pptp / direct) ──────────
exit_label(){ case "$1" in socks) echo "носок (SOCKS5)";; ovpn) echo "OpenVPN";; pptp) echo "PPTP";; *) echo "прямой (C2)";; esac; }

active_exit(){  # ГЛОБАЛЬНЫЙ режим выхода (то, что получают неназначенные клиенты)
  # Источник правды — global-exit.conf (пишет `gate global`). Раньше читались флаги
  # socks.state/vpn.state, и залипший socks.state=on показывал «носок», когда реально
  # работал VPN. Флаги оставлены как фоллбэк для конфигов, где global-exit.conf ещё нет.
  local g; g="$(global_get)"
  case "$g" in
    ovpn|pptp) echo "$g"; return ;;
    socks)     echo socks; return ;;
    c2)        echo direct; return ;;
  esac
  [ "$(cat "$SOCKS_STATE" 2>/dev/null)" = on ] && { echo socks; return; }
  if [ "$(cat "$VPN_STATE" 2>/dev/null)" = on ]; then . "$VPN_META" 2>/dev/null; echo "${TYPE:-ovpn}"; return; fi
  echo direct
}

exit_off_one(){  # выключить конкретный активный режим без вопросов
  case "$1" in socks) cmd_socks off ;; ovpn|pptp|vpn) vpn_off ;; esac
}

# Перед включением режима $1: если активен ДРУГОЙ — спросить и выключить его.
# 0 = можно продолжать, 1 = отменено. -y / GATE_YES=1 → без вопроса.
ensure_exclusive(){
  local want="$1" cur; cur=$(active_exit)
  [ "$cur" = direct ] && return 0
  [ "$cur" = "$want" ] && return 0
  # ПОЛОСЫ: если устройства уже разведены по выходам, режимы НЕ взаимоисключающие — носок и
  # VPN живут на C2 одновременно, а кому какой выход, решает полоса. Спрашивать не о чем.
  if lanes_enabled && [ "$(lane_any_count)" != 0 ]; then
    echo "→ Полосы активны: «$(exit_label "$cur")» остаётся, добавляю «$(exit_label "$want")» рядом"
    return 0
  fi
  local ans
  if [ "${GATE_YES:-0}" = 1 ]; then ans=y
  elif [ -t 0 ]; then
    printf "Сейчас активен %s«%s»%s. Переключить на «%s»? [y/N] " "$YEL" "$(exit_label "$cur")" "$R" "$(exit_label "$want")"
    read -r ans
  else
    echo "Активен «$(exit_label "$cur")». Запусти интерактивно или добавь -y, чтобы переключить."; return 1
  fi
  case "$ans" in
    y|Y|yes|YES|да|д|Да) echo "→ Выключаю «$(exit_label "$cur")»…"; exit_off_one "$cur"; return 0 ;;
    *) echo "Отменено."; return 1 ;;
  esac
}

exit_has(){  # есть ли конфиг типа $1 на выходном хопе
  case "$1" in
    ovpn) s2_exec "test -f $C2_VPN_DIR/client.ovpn && echo Y" 2>/dev/null | grep -q Y ;;
    pptp) s2_exec "test -f /etc/ppp/peers/gate-vpn && echo Y" 2>/dev/null | grep -q Y ;;
  esac
}

# ── set: залить конфиги на выходной хоп (оба типа могут лежать одновременно) ──
ovpn_set(){
  local f="${1:-}" u="${2:-}" pw="${3:-}"
  [ -f "$f" ] || { echo "Файл не найден: $f  (положи .ovpn на малину, напр. в /mnt/ssd, и укажи путь)"; exit 1; }
  echo "→ Заливаю конфиг OpenVPN на C2…"
  ensure_vpn_script || { echo "не удалось доставить скрипт"; exit 1; }
  s2_exec "umask 077; mkdir -p $C2_VPN_DIR; echo DIROK" >/dev/null
  # Нормализация под Linux/OpenVPN 2.6: Windows-only директивы (block-outside-dns, register-dns,
  # dhcp-renew/release) на Linux ФАТАЛЬНЫ («Unrecognized option»), хотя на Windows-роутере друга
  # глотаются. Префиксуем штатным ignore-unknown-option — строки юзера НЕ трогаем, просто делаем
  # их терпимыми (на Linux эти опции и так бессмысленны). Так чужой .ovpn заводится без правок.
  local winopts="block-outside-dns register-dns dhcp-renew dhcp-release"
  local found; found="$(grep -hoE "^[[:space:]]*(block-outside-dns|register-dns|dhcp-renew|dhcp-release)" "$f" 2>/dev/null | tr -d '[:space:]' | sort -u | tr '\n' ' ')"
  local ntmp; ntmp="$(mktemp)" || { echo "  ✗ mktemp не удался"; exit 1; }
  { printf 'ignore-unknown-option %s\n' "$winopts"; cat "$f"; } > "$ntmp"
  [ -n "$found" ] && echo "  ${YEL}⚠ нормализую Windows-only директивы (на Linux игнорируются):${R} $found"
  push_to_exit "$ntmp" "$C2_VPN_DIR/client.ovpn" && echo "  ✓ конфиг залит" || { echo "  ✗ заливка не удалась"; rm -f "$ntmp"; exit 1; }
  rm -f "$ntmp"
  if [ -n "$u" ]; then
    s2_exec "umask 077; printf '%s\n%s\n' '$u' '$pw' > $C2_VPN_DIR/auth.txt; echo AUTHOK" >/dev/null
    echo "  ✓ логин/пароль сохранён на C2"
  else
    s2_exec "rm -f $C2_VPN_DIR/auth.txt" >/dev/null 2>&1
    # Голый `auth-user-pass` без кредов = openvpn на C2 спросит логин/пароль через
    # systemd-ask-password и повиснет навсегда (демон, tty нет). Ловим сразу при set.
    if grep -qE '^[[:space:]]*auth-user-pass[[:space:]]*$' "$f" 2>/dev/null; then
      echo "  ${RED}✗ конфиг требует логин/пароль (auth-user-pass), а они не заданы${R}"
      echo "     ${D}перезалей с кредами:${R} gate ovpn set $f <логин> <пароль>"
      echo "     ${D}иначе gate ovpn on завершится ошибкой (туннель не встанет)${R}"
      return 1
    fi
  fi
  echo "Готово. Включить: gate ovpn on"
}
# Линтер .ovpn: проверяет конфиг на совместимость с pi_gate (Linux/OpenVPN 2.6 на C2) и
# даёт рекомендации. Парсер на python в ЭКРАНИРОВАННОМ heredoc (<<'PYEOF') + имя файла через
# argv → никакой подстановки шелла (защита от граблей с бэктиками/$()). Только чтение, без сети.
ovpn_check(){
  local f="${1:-}"
  [ -f "$f" ] || { echo "Файл не найден: $f"; echo "Использование: gate ovpn check <файл.ovpn>"; exit 1; }
  python3 - "$f" <<'PYEOF'
import sys, re
f = sys.argv[1]
try:
    lines = open(f, errors="replace").read().splitlines()
except Exception as e:
    print("не прочитать файл:", e); sys.exit(2)

# вырезаем инлайн-блоки (<ca>…</ca> и т.п.), оставляем только директивы
directives = []; inblock = False; inline = set()
for ln in lines:
    s = ln.strip()
    m = re.match(r"<(/?)([A-Za-z0-9_-]+)>$", s)
    if m:
        if not m.group(1): inblock = True; inline.add(m.group(2).lower())
        else: inblock = False
        continue
    if inblock or not s or s[0] in "#;": continue
    directives.append(s)

def has(opt): return [d for d in directives if d.split()[0].lower() == opt]
issues = []
def add(lvl, msg, fix=""): issues.append((lvl, msg, fix))

if not has("remote"):
    add("FAIL", "нет директивы «remote» — некуда подключаться", "добавь: remote <host> <port>")
dev = has("dev")
if dev and "tap" in dev[0].lower():
    add("FAIL", "dev tap (L2/мост) — pi_gate работает только через tun (L3)", "нужен конфиг с dev tun")

win = sorted({d.split()[0].lower() for d in directives
              if d.split()[0].lower() in ("block-outside-dns","register-dns","dhcp-renew","dhcp-release")})
if win:
    add("OK", "Windows-only директивы (%s) — авто-нейтрализуются при gate ovpn set" % ", ".join(win))

for opt in ("ca","cert","key","tls-auth","tls-crypt","tls-crypt-v2","pkcs12"):
    h = has(opt)
    if h and opt not in inline and len(h[0].split()) > 1:
        add("FAIL", "«%s %s» ссылается на ВНЕШНИЙ файл — на C2 его нет" % (opt, h[0].split()[1]),
            "вставь содержимое инлайном: <%s>…</%s> прямо в .ovpn" % (opt, opt))

if has("auth-user-pass"):
    add("WARN", "сервер требует логин/пароль (auth-user-pass)",
        "задавай с кредами: gate ovpn set <файл> <user> <pass>")

comp = [d.split()[0].lower() for d in directives if d.split()[0].lower() in ("comp-lzo","compress")]
if comp:
    add("WARN", "включена компрессия (%s) — работает, но это риск (VORACLE)" % comp[0],
        "оставь как есть: должна совпадать с сервером")

ciph = has("cipher")
if ciph and len(ciph[0].split()) > 1 and ciph[0].split()[1].upper() in ("BF-CBC","DES-CBC","RC2-CBC"):
    c = ciph[0].split()[1].upper()
    add("WARN", "устаревший cipher %s (в OpenVPN 2.6 убран из дефолта)" % c,
        "если не подключится — добавь в .ovpn: data-ciphers-fallback %s" % c)

ico = {"OK": "✓", "WARN": "⚠", "FAIL": "✗"}
rem, pr = has("remote"), has("proto")
print("Проверка %s" % f)
if rem: print("  remote: %s" % " ".join(rem[0].split()[1:]))
if pr:  print("  proto:  %s" % " ".join(pr[0].split()[1:]))
print()
fails = sum(1 for l,_,_ in issues if l == "FAIL")
warns = sum(1 for l,_,_ in issues if l == "WARN")
if not issues:
    print("  ✓ явных несовместимостей не найдено")
for lvl, msg, fix in issues:
    print("  %s %s" % (ico[lvl], msg))
    if fix: print("      → %s" % fix)
print()
if fails:
    print("ИТОГ: критич.=%d, предупр.=%d — как есть НЕ заведётся (см. → выше)" % (fails, warns)); sys.exit(1)
elif warns:
    print("ИТОГ: предупр.=%d — должно заработать: gate ovpn set <файл> → gate ovpn test" % warns)
else:
    print("ИТОГ: ок — gate ovpn set <файл> → gate ovpn test")
PYEOF
}
