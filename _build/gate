# ─── Роутинг ──────────────────────────────────────────────────────────
# -y / --yes в любом месте → авто-подтверждение переключения exit-режима
GATE_YES=0; _args=()
for _a in "$@"; do case "$_a" in -y|--yes) GATE_YES=1 ;; *) _args+=("$_a") ;; esac; done
set -- "${_args[@]}"

case "${1:-help}" in
  info) cmd_info ;;
  wan)  shift; cmd_wan "$@" ;;
  eth)  shift; cmd_eth "$@" ;;
  wifi) shift; cmd_wifi "$@" ;;
  ap)   shift; cmd_ap "$@" ;;
  clients) cmd_clients ;;
  client) shift; cmd_client "$@" ;;
  global) shift; cmd_global "$@" ;;
  lanes)  shift; cmd_lanes "$@" ;;
  traffic) shift; cmd_traffic "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  freeze) shift; cmd_freeze "$@" ;;
  unfreeze) cmd_unfreeze ;;
  socks) shift; cmd_socks "$@" ;;
  ovpn)  shift; cmd_ovpn "$@" ;;
  pptp)  shift; cmd_pptp "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  wipe)  cmd_wipe ;;
  web)   shift; cmd_web "$@" ;;
  exit)  shift; cmd_exit "$@" ;;
  dns)   shift; cmd_dns "$@" ;;
  osfp)  shift; cmd_osfp "$@" ;;
  setup) shift; exec /usr/local/bin/gate-setup "$@" ;;
  chain) exec /usr/local/bin/gate-setup show ;;
  logs) shift; cmd_logs "$@" ;;
  --version|-V|version) echo "gate $GATE_VERSION" ;;
  help|-h|--help) cmd_help ;;
  *) echo "Неизвестная команда: $1"; echo; cmd_help; exit 1 ;;
esac
