  ${g}gate profile save socks <имя> <ip> <port> [user] [pass]${R}
  ${g}gate profile save pptp <имя> <server> <user> <pass>${R}
  ${g}gate profile save ovpn <имя> <файл.ovpn> [user] [pass]${R}  ${D}(копирует .ovpn)${R}
  ${g}gate profile use <тип> <имя>${R}  активировать сохранённый
  ${g}gate profile rm  <тип> <имя>${R}  удалить профиль
