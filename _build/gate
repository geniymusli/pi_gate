  ${g}gate wifi mac${R} ${D}[random|aa:bb:cc:dd:ee:ff|reset]${R}  MAC wlan0

${hr}━━ РАЗДАЧА (AP для устройств) ━━━━━━━━━━━━━━━━━━━━━━━━━${R}
